{
    auto_https off
    admin off
    frankenphp {
        php_ini ffi.enable preload
        php_ini ffi.preload /usr/local/lib/nntmux/release-presentation.h
        php_ini opcache.preload /usr/local/lib/nntmux/release-presentation-preload.php
    }
}
:80 {
    root * /app/public
    encode zstd gzip
    php_server
}
