    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" logs -f --tail=200 ${s:-}

# Attach to the indexer tmux session (detach: Ctrl-a d)
tmux *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" exec indexer tmux attach -t nntmux

# Shell in the web container
shell *args:
