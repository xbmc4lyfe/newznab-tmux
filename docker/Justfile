# NNTmux docker/ stack lifecycle (Rust-native).
# Run from repo root: just docker <recipe>  or: just -f docker/Justfile <recipe>
set positional-arguments := true
set shell := ["bash", "-cu"]
# The running just binary, so nested calls work where just is not on PATH (noninteractive SSH).
export JUST := just_executable()

CURDIR := canonicalize(module_directory())
COMPOSE := CURDIR + "/bin/compose"
ENV_FILE := CURDIR + "/.env"
ENV_KEYS := "COMPOSE_FILE COMPOSE_OVERLAY_FILE DC APP_IMAGE DEPLOY_BY DEPLOY_SYNC_REMOTE DEPLOY_GIT_REMOTE DEPLOY_GIT_BRANCH DEPLOY_HEALTH_TIMEOUT DEPLOY_LOCK_DIR DEPLOY_LOG APP_PORT DB_DATABASE DB_ROOTPASSWORD DRY_RUN s cmd"

# Recipe prelude. Precedence: trailing KEY=VAL arguments, then the environment, then docker/.env.
# docker/.env is read with the parser docker/bin/compose shares (Compose's quoting rules), never
# sourced, and only the keys above are taken. ARGS holds the remaining arguments.
LOAD_ENV := '''ARGS=()
    for arg in "$@"; do
        if [[ "$arg" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]]; then export "$arg"; else ARGS+=("$arg"); fi
    done
    dotenv() { [ -n "${!1+set}" ] || export "$1=$3"; }
    if [ -f "''' + ENV_FILE + '''" ]; then
        eval "$(python3 -I "''' + CURDIR + '''/bin/compose_dotenv.py" "''' + ENV_FILE + '''" ''' + ENV_KEYS + ''')"
    fi'''

DATA_DIRS := "data/storage data/mariadb data/redis data/manticore data/caddy/data data/caddy/config data/prometheus data/grafana logs/mariadb logs/manticore logs/caddy backups"

# Show available stack recipes
help *args:
    @"$JUST" --list --justfile "{{module_file()}}"

# Generate docker/.env and config/app.env (secrets, NNTP creds); safe to re-run
env *args:
    #!/usr/bin/env bash
    set -euo pipefail
    "{{CURDIR}}/bin/generate-env"
    "$JUST" --justfile "{{module_file()}}" perms "$@"

# Create bind-mount directories
dirs *args:
    cd "{{CURDIR}}" && mkdir -p {{DATA_DIRS}}

# Linux hosts: let the app containers' user (33:33) use their bind mounts
perms *args:
    #!/usr/bin/env bash
    set -euo pipefail
    "$JUST" --justfile "{{module_file()}}" dirs
    if [ "$(uname -s)" = Linux ]; then
        docker run --rm -v "{{CURDIR}}:/stack" alpine:3.22.2 sh -c \
            "chown -R 33:33 /stack/data/storage && chown $(id -u):33 /stack/config/app.env && chmod 0640 /stack/config/app.env"
    fi

# Build the app image (APP_IMAGE, default nntmux/rust:local) from the repo root
build *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    rev=$(git -C "{{CURDIR}}" rev-parse --short=12 HEAD)
    docker build --label "org.opencontainers.image.revision=$rev" -t "${APP_IMAGE:-nntmux/rust:local}" "{{CURDIR}}/.."

# Guarded rollout: lock, branch check, build, migrate, recreate changed services, wait healthy
deploy *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    exec "{{CURDIR}}/bin/deploy" "${ARGS[@]}"

# What deploy would do, without building or changing anything
deploy-plan *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    DRY_RUN=1 exec "{{CURDIR}}/bin/deploy" "${ARGS[@]}"

# First-time install on an empty database: env, build, nntmux-ctl init, seed, start
init *args:
    #!/usr/bin/env bash
    set -euo pipefail
    "$JUST" --justfile "{{module_file()}}" env
    {{LOAD_ENV}}
    "$JUST" --justfile "{{module_file()}}" build
    "{{COMPOSE}}" up -d --wait mariadb redis manticore mailpit
    "{{COMPOSE}}" run --rm --no-deps migrate nntmux-ctl init
    "$JUST" --justfile "{{module_file()}}" seed-db
    "{{COMPOSE}}" up -d --wait
    echo "NNTmux: http://localhost:${APP_PORT:-8080}  (admin password: grep ADMIN_PASS docker/config/app.env)"

# Apply config/seed/groups.sql + tuning.sql to the bundled MariaDB
seed-db *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE:-nntmux}" < "{{CURDIR}}/config/seed/groups.sql"
    "{{COMPOSE}}" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE:-nntmux}" < "{{CURDIR}}/config/seed/tuning.sql"

# Start the stack as built (no build, no git checks); use deploy for a rollout
up *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" up -d --wait "${ARGS[@]}"

# Stop the stack. Workers drain in-flight work within their stop grace.
down *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" down

# Restart services (s=service for one; workers drain first)
restart *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" restart ${s:-}

# Service status / health
ps *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" ps

# Follow logs (s=service)
logs *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" logs -f --tail=200 ${s:-}

# Run nntmux-ctl in a one-off container: just -f docker/Justfile ctl cmd="search inspect"
ctl *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    exec python3 -I -c 'import os, shlex, sys; argv = sys.argv[2:] + shlex.split(sys.argv[1]); os.execvp(argv[0], argv)' \
        "${cmd:-}" "{{COMPOSE}}" run --rm --no-deps migrate nntmux-ctl

# MariaDB client as root (bundled MariaDB only)
mysql *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{COMPOSE}}" exec mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE:-nntmux}"

# Dump the bundled MariaDB to backups/ (keeps 7)
backup *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    umask 077
    mkdir -p "{{CURDIR}}/backups"
    chmod 0700 "{{CURDIR}}/backups"
    out="{{CURDIR}}/backups/nntmux-$(date +%Y%m%d-%H%M%S).sql.gz"
    tmp="$out.partial"
    trap 'rm -f "$tmp"' EXIT
    "{{COMPOSE}}" exec -T mariadb mariadb-dump -uroot -p"${DB_ROOTPASSWORD}" --single-transaction --quick --routines "${DB_DATABASE:-nntmux}" \
        | gzip > "$tmp"
    mv "$tmp" "$out"
    ls -1t "{{CURDIR}}/backups"/nntmux-*.sql.gz | tail -n +8 | xargs -r rm --
    ls -lh "{{CURDIR}}/backups" | tail -n 3

# Indexing progress snapshot (groups, binaries, releases, predb)
status *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    echo "SELECT COUNT(*) active_groups, SUM(last_record>0) scanned FROM usenet_groups WHERE active=1; \
    SELECT (SELECT COUNT(*) FROM collections) collections, (SELECT COUNT(*) FROM binaries) binaries, (SELECT COUNT(*) FROM releases) releases; \
    SELECT source, COUNT(*) pres FROM predb GROUP BY source ORDER BY 2 DESC LIMIT 10;" \
        | "{{COMPOSE}}" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE:-nntmux}" -t
