    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" exec web bash

# Run artisan: just -f docker/Justfile artisan cmd="predb:import-feed --dry-run"
artisan *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    exec python3 -I -c '{{EXEC_SPLIT}}' "${cmd:-}" "{{CURDIR}}/bin/compose" exec web php artisan

# MariaDB client as root
mysql *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" exec mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}"

# Dump MariaDB to backups/ (keeps 7)
backup *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    umask 077
    mkdir -p "{{CURDIR}}/backups"
    chmod 0700 "{{CURDIR}}/backups"
    out="{{CURDIR}}/backups/nntmux-$(date +%Y%m%d-%H%M%S).sql.gz"
    tmp="$out.partial"
    trap 'rm -f "$tmp"' EXIT
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb-dump -uroot -p"${DB_ROOTPASSWORD}" --single-transaction --quick --routines "${DB_DATABASE}" \
        | gzip > "$tmp"
    mv "$tmp" "$out"
    ls -1t "{{CURDIR}}/backups"/nntmux-*.sql.gz | tail -n +8 | xargs -r rm --
    ls -lh "{{CURDIR}}/backups" | tail -n 3

# Indexing progress snapshot (groups, binaries, releases, predb)
status *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    echo "SELECT COUNT(*) active_groups, SUM(last_record>0) scanned FROM usenet_groups WHERE active=1; \
    SELECT (SELECT COUNT(*) FROM collections) collections, (SELECT COUNT(*) FROM binaries) binaries, (SELECT COUNT(*) FROM releases) releases; \
    SELECT source, COUNT(*) pres FROM predb GROUP BY source ORDER BY 2 DESC LIMIT 10;" \
        | "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" -t
