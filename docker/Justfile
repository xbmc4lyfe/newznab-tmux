# First-time install: build, migrate+seed, indexes, groups, tuning, predb seed, start
init *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "$JUST" --justfile "{{module_file()}}" --working-directory "{{CURDIR}}" env "$@"
    "$JUST" --justfile "{{module_file()}}" --working-directory "{{CURDIR}}" dirs "$@"
    "$JUST" --justfile "{{module_file()}}" --working-directory "{{CURDIR}}" build "$@"
    "{{CURDIR}}/bin/compose" up -d --wait mariadb redis manticore mailpit
    if [ -f "{{CURDIR}}/data/install/install.lock" ]; then
        echo "install.lock present; skipping nntmux:deploy-init"
    else
        "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan nntmux:deploy-init --no-interaction
    fi
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan monitoring:install --sail --no-interaction
    "$JUST" --justfile "{{module_file()}}" --working-directory "{{CURDIR}}" seed-db "$@"
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan predb:import-feed --pages=20 || true
    "{{CURDIR}}/bin/compose" up -d
    echo "NNTmux: http://localhost:${APP_PORT:-8080}  (admin password: grep ADMIN_PASS docker/config/app.env)"

# Apply config/seed/groups.sql + tuning.sql and clear the settings cache
seed-db *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" < "{{CURDIR}}/config/seed/groups.sql"
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" < "{{CURDIR}}/config/seed/tuning.sql"
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan cache:clear

# Re-seed groups/tuning and restart the indexer to pick it up
seed *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "$JUST" --justfile "{{module_file()}}" --working-directory "{{CURDIR}}" seed-db "$@"
    "{{CURDIR}}/bin/compose" restart indexer

# First bringup, or safe guarded deploy when app containers already exist
up *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    DEPLOY_BY="$DEPLOY_BY" exec "{{CURDIR}}/bin/deploy-guard" run up -- "{{CURDIR}}/bin/up-app"

# Stop the stack (tmux session stops cleanly)
down *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" down

# Restart app services (s=service for one)
restart *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    if [ -n "${s:-}" ]; then
        "{{CURDIR}}/bin/compose" restart $s
    else
        "{{CURDIR}}/bin/compose" restart web horizon scheduler indexer
    fi

# Service status / health
ps *args:
    #!/usr/bin/env bash
    set -euo pipefail
    {{LOAD_ENV}}
    "{{CURDIR}}/bin/compose" ps

# Follow logs (s=service)
logs *args:
