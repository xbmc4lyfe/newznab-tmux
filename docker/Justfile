# NNTmux docker/ stack lifecycle.
# Run from repo root: just docker <recipe>  or: just -f docker/Justfile <recipe>
set dotenv-load := true
set positional-arguments := true
set shell := ["bash", "-cu"]

CURDIR := justfile_directory()
REPO := parent_directory(CURDIR)

export COMPOSE_FILE := env("COMPOSE_FILE", CURDIR + "/docker-compose.yml")
export DC := env("DC", "docker compose --project-directory " + quote(CURDIR))
export HELPER_IMAGE := env("HELPER_IMAGE", "alpine:3.22.2")
export BASE_IMAGE := env("BASE_IMAGE", "nntmux/base:local")
export APP_IMAGE := env("APP_IMAGE", "nntmux/app:local")
export WEB_IMAGE := env("WEB_IMAGE", env("APP_IMAGE", "nntmux/web:local"))
export HORIZON_IMAGE := env("HORIZON_IMAGE", env("APP_IMAGE", "nntmux/horizon:local"))
export SCHEDULER_IMAGE := env("SCHEDULER_IMAGE", env("APP_IMAGE", "nntmux/scheduler:local"))
export INDEXER_IMAGE := env("INDEXER_IMAGE", env("APP_IMAGE", "nntmux/indexer:local"))
export DEPLOY_MIN_INTERVAL := env("DEPLOY_MIN_INTERVAL", "900")
export DEPLOY_DRAIN_TIMEOUT := env("DEPLOY_DRAIN_TIMEOUT", "90")
export DEPLOY_SCHEDULER_DRAIN_TIMEOUT := env("DEPLOY_SCHEDULER_DRAIN_TIMEOUT", "1800")
export DEPLOY_HEALTH_TIMEOUT := env("DEPLOY_HEALTH_TIMEOUT", "240")
export DEPLOY_BY := env("DEPLOY_BY", "")
export FORCE := env("FORCE", "")
export s := env("s", "")
export cmd := env("cmd", "")

DATA_DIRS := "data/storage data/install data/mariadb data/redis data/manticore data/caddy/data data/caddy/config data/prometheus data/grafana logs/mariadb logs/manticore logs/caddy backups"

# Show available stack recipes
help:
    @just --list --justfile "{{justfile()}}"

# Generate docker/.env and config/app.env (secrets, NNTP creds); safe to re-run
env *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/generate-env"
    just --justfile "{{justfile()}}" --working-directory "{{CURDIR}}" perms

# Create bind-mount directories
dirs *args:
    @cd "{{CURDIR}}" && mkdir -p {{DATA_DIRS}}

# Linux hosts: let the app containers' user (33:33) use their bind mounts
perms *args: dirs
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    if [ "$(uname -s)" = Linux ]; then
        docker run --rm -v "{{CURDIR}}:/stack" "$HELPER_IMAGE" sh -c \
            "chown -R 33:33 /stack/data/storage /stack/data/install && chown $(id -u):33 /stack/config/app.env && chmod 0640 /stack/config/app.env"
    fi

# Build only the cached base OS/PHP-extension image (nntmux/base:local)
build-base *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    docker build --target base -t "$BASE_IMAGE" -f "{{REPO}}/Dockerfile" "{{REPO}}"

# Build dirty self-hosted service image targets; skipped when nothing runtime-relevant changed
build *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    SKIP_IF_UNCHANGED=1 STAMP_ON_SUCCESS=1 \
        REQUIRE_IMAGE="$WEB_IMAGE $HORIZON_IMAGE $SCHEDULER_IMAGE $INDEXER_IMAGE" \
        DEPLOY_STAMP="{{CURDIR}}/.build.stamp" FORCE="$FORCE" \
        DEPLOY_MIN_INTERVAL=0 RECORD_DEPLOY_TIME=0 \
        DEPLOY_CONFIG_COMMAND= CHECK_UNCHANGED_COMMAND= CHECK_HEALTH_COMMAND= \
        DEPLOY_BY="$DEPLOY_BY" "{{CURDIR}}/bin/deploy-guard" run build -- \
        "{{CURDIR}}/bin/build-images"

# Internal: build dirty service image targets without acquiring a second guard
build-images *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/build-images"

# Inspect per-service change detection, build targets, and selective rollout actions without deploying
deploy-plan *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    if [ ! -f "{{CURDIR}}/.env" ]; then
        export DB_PASSWORD="${DB_PASSWORD:-preview}" DB_ROOTPASSWORD="${DB_ROOTPASSWORD:-preview}"
    fi
    DEPLOY_CONFIG_COMMAND="{{CURDIR}}/bin/deploy-current" "{{CURDIR}}/bin/deploy-plan" --explain

# Smart selective deploy: skips non-runtime changes, builds/drains/recreates only affected containers
deploy *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    if [ "${DRY_RUN:-0}" = "1" ]; then
        if [ ! -f "{{CURDIR}}/.env" ]; then
            export DB_PASSWORD="${DB_PASSWORD:-preview}" DB_ROOTPASSWORD="${DB_ROOTPASSWORD:-preview}"
        fi
        DEPLOY_CONFIG_COMMAND="{{CURDIR}}/bin/deploy-current" "{{CURDIR}}/bin/deploy-plan" --explain
        exit 0
    fi
    SKIP_IF_UNCHANGED=1 STAMP_ON_SUCCESS=1 RECORD_DEPLOY_TIME=1 \
        REQUIRE_IMAGE="$WEB_IMAGE $HORIZON_IMAGE $SCHEDULER_IMAGE $INDEXER_IMAGE" \
        DEPLOY_CONFIG_COMMAND="{{CURDIR}}/bin/deploy-current" \
        CHECK_UNCHANGED_COMMAND="{{CURDIR}}/bin/deploy-current" \
        CHECK_HEALTH_COMMAND="{{CURDIR}}/bin/deploy-current" \
        DEPLOY_MIN_INTERVAL="$DEPLOY_MIN_INTERVAL" \
        DEPLOY_DRAIN_TIMEOUT="$DEPLOY_DRAIN_TIMEOUT" \
        DEPLOY_SCHEDULER_DRAIN_TIMEOUT="$DEPLOY_SCHEDULER_DRAIN_TIMEOUT" \
        DEPLOY_HEALTH_TIMEOUT="$DEPLOY_HEALTH_TIMEOUT" \
        APP_IMAGE="$APP_IMAGE" WEB_IMAGE="$WEB_IMAGE" HORIZON_IMAGE="$HORIZON_IMAGE" \
        SCHEDULER_IMAGE="$SCHEDULER_IMAGE" INDEXER_IMAGE="$INDEXER_IMAGE" FORCE="$FORCE" \
        DEPLOY_BY="$DEPLOY_BY" "{{CURDIR}}/bin/deploy-guard" run deploy -- \
        "{{CURDIR}}/bin/deploy-app"

# First-time install: build, migrate+seed, indexes, groups, tuning, predb seed, start
init *args: env dirs build
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/compose" up -d --wait mariadb redis manticore mailpit
    if [ -f "{{CURDIR}}/data/install/install.lock" ]; then
        echo "install.lock present; skipping nntmux:deploy-init"
    else
        "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan nntmux:deploy-init --no-interaction
    fi
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan monitoring:install --sail --no-interaction
    just --justfile "{{justfile()}}" --working-directory "{{CURDIR}}" seed-db
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan predb:import-feed --pages=20 || true
    "{{CURDIR}}/bin/compose" up -d
    echo "NNTmux: http://localhost:${APP_PORT:-8080}  (admin password: grep ADMIN_PASS docker/config/app.env)"

# Apply config/seed/groups.sql + tuning.sql and clear the settings cache
seed-db *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" < "{{CURDIR}}/config/seed/groups.sql"
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" < "{{CURDIR}}/config/seed/tuning.sql"
    "{{CURDIR}}/bin/compose" run --rm --no-deps web php artisan cache:clear

# Re-seed groups/tuning and restart the indexer to pick it up
seed *args: seed-db
    "{{CURDIR}}/bin/compose" restart indexer

# First bringup, or safe guarded deploy when app containers already exist
up *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    DEPLOY_BY="$DEPLOY_BY" "{{CURDIR}}/bin/deploy-guard" run up -- "{{CURDIR}}/bin/up-app"

# Stop the stack (tmux session stops cleanly)
down *args:
    "{{CURDIR}}/bin/compose" down

# Restart app services (s=service for one)
restart *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    if [ -n "${s:-}" ]; then
        "{{CURDIR}}/bin/compose" restart $s
    else
        "{{CURDIR}}/bin/compose" restart web horizon scheduler indexer
    fi

# Service status / health
ps *args:
    "{{CURDIR}}/bin/compose" ps

# Follow logs (s=service)
logs *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/compose" logs -f --tail=200 ${s:-}

# Attach to the indexer tmux session (detach: Ctrl-a d)
tmux *args:
    "{{CURDIR}}/bin/compose" exec indexer tmux attach -t nntmux

# Shell in the web container
shell *args:
    "{{CURDIR}}/bin/compose" exec web bash

# Run artisan: just -f docker/Justfile artisan cmd="predb:import-feed --dry-run"
artisan *args:
    #!/usr/bin/env bash
    set -euo pipefail
    for arg in "$@"; do [[ "$arg" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] && export "$arg"; done
    "{{CURDIR}}/bin/compose" exec web php artisan ${cmd}

# MariaDB client as root
mysql *args:
    "{{CURDIR}}/bin/compose" exec mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}"

# Dump MariaDB to backups/ (keeps 7)
backup *args:
    #!/usr/bin/env bash
    set -euo pipefail
    umask 077
    mkdir -p "{{CURDIR}}/backups"
    chmod 0700 "{{CURDIR}}/backups"
    out="{{CURDIR}}/backups/nntmux-$(date +%Y%m%d-%H%M%S).sql.gz"
    tmp="$out.partial"
    trap 'rm -f "$tmp"' EXIT
    "{{CURDIR}}/bin/compose" exec -T mariadb mariadb-dump -uroot -p"${DB_ROOTPASSWORD}" --single-transaction --quick --routines "${DB_DATABASE}" \
        | gzip > "$tmp"
    mv "$tmp" "$out"
    ls -1t "{{CURDIR}}/backups"/nntmux-*.sql.gz | tail -n +8 | xargs -r rm --
    ls -lh "{{CURDIR}}/backups" | tail -n 3

# Indexing progress snapshot (groups, binaries, releases, predb)
status *args:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "SELECT COUNT(*) active_groups, SUM(last_record>0) scanned FROM usenet_groups WHERE active=1; \
    SELECT (SELECT COUNT(*) FROM collections) collections, (SELECT COUNT(*) FROM binaries) binaries, (SELECT COUNT(*) FROM releases) releases; \
    SELECT source, COUNT(*) pres FROM predb GROUP BY source ORDER BY 2 DESC LIMIT 10;" \
        | "{{CURDIR}}/bin/compose" exec -T mariadb mariadb -uroot -p"${DB_ROOTPASSWORD}" "${DB_DATABASE}" -t
