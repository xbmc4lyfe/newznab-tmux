# Remote verification worker: copy to app.env (ignored by Git) and fill in the blanks.
APP_NAME=NNTmux
APP_ENV=production
# The primary's APP_KEY.
APP_KEY=
APP_DEBUG=false
APP_URL=http://primary-host:8080
LOG_CHANNEL=daily
LOG_LEVEL=info

# The primary's shared database, over TLS with the CA mounted from config/ca.pem.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=nntmux
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/mysql/ssl/ca.pem

# Nothing on this host needs Redis, a queue or sessions.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# This host's own NNTP account; spot checks use only the primary server settings.
NNTP_SERVER=
NNTP_PORT=563
NNTP_SSLENABLED=true
NNTP_USERNAME=
NNTP_PASSWORD=
NNTP_CONNECTIONS=50
NNTP_SOCKET_TIMEOUT=120
NNTP_COMPRESSED_HEADERS=true

# Verification only, in a slot range no other host uses (slots offset+1 to offset+workers).
RELEASE_VERIFICATION_WORKER_ONLY=true
RELEASE_VERIFICATION_HOST=
RELEASE_VERIFICATION_SLOT_OFFSET=
RELEASE_VERIFICATION_CANDIDATE_WORKERS=50
RELEASE_VERIFICATION_WORKER_LIMIT=1000
RELEASE_VERIFICATION_WORKER_SECONDS=300
RELEASE_VERIFICATION_PUBLISH_URL=http://primary-host:8090/internal/release-verification/publish
