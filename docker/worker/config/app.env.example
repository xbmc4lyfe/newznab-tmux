# Remote verification worker: copy to app.env (ignored by Git) and fill in the blanks.
APP_NAME=NNTmux
APP_ENV=production
# The primary's APP_KEY.
APP_KEY=
APP_DEBUG=false
APP_URL=http://primary-host:8080
LOG_CHANNEL=daily
LOG_LEVEL=info

# The primary's shared database, over TLS with the CA mounted from config/ca.pem.
DB_CONNECTION=mariadb
DB_HOST=
DB_PORT=3306
DB_DATABASE=nntmux
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/mysql/ssl/ca.pem

# Nothing on this host needs Redis, a queue or sessions.
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# This host's own NNTP account; spot checks use only the primary server settings.
NNTP_SERVER=
NNTP_PORT=563
NNTP_SSLENABLED=true
NNTP_USERNAME=
NNTP_PASSWORD=
NNTP_CONNECTIONS=50
NNTP_SOCKET_TIMEOUT=120
NNTP_COMPRESSED_HEADERS=true

# Native yEnc decoder inside the app image. Without it the PHP decoder runs, which made each
# passing verification about 10x slower.
YENC_DECODER=auto
YENC_NATIVE_LIBRARY=/usr/local/lib/nntmux/libnzbyenc.so

# Verification only, in a slot range no other host uses (slots offset+1 to offset+workers).
RELEASE_VERIFICATION_WORKER_ONLY=true
RELEASE_VERIFICATION_HOST=
RELEASE_VERIFICATION_SLOT_OFFSET=
RELEASE_VERIFICATION_CANDIDATE_WORKERS=50
RELEASE_VERIFICATION_WORKER_LIMIT=1000
RELEASE_VERIFICATION_WORKER_SECONDS=300
RELEASE_VERIFICATION_PUBLISH_URL=http://primary-host:8090/internal/release-verification/publish
# Batch publication (primary must run a version with the batch endpoint; else workers fall back to the single URL).
# RELEASE_VERIFICATION_PUBLISH_BATCH_URL=http://primary-host:8090/internal/release-verification/publish-batch
# Asynchronous hand-off: workers queue verified results in a per-host outbox and forwarder processes send
# them to the batch endpoint. Leave off until the primary serves the batch endpoint.
# RELEASE_VERIFICATION_PUBLISH_ASYNC=true
# RELEASE_VERIFICATION_PUBLISH_FORWARDERS=4
# Milliseconds (0-30000) a forwarder waits for a batch to fill before sending a partial one; 0 sends at once.
# RELEASE_VERIFICATION_PUBLISH_FORWARD_LINGER_MS=0
# Primary host requirements (set there, not here):
# - RELEASE_VERIFICATION_PUBLISH_ENDPOINT=true in the primary's app.env. It defaults to false,
#   so the endpoint returns 404 and every publish fails with "Remote publication failed: HTTP 404".
# - INTERNAL_BIND in the primary's docker/.env must bind port 8090 to a LAN address the workers
#   can reach (the default 127.0.0.1 disables it).
