#!/usr/bin/env bash

if [ -n "$WWWUSER" ]; then
    # Ubuntu already owns UID 1000 in the base image. Allow Sail to share the
    # requested host UID so bind-mounted files remain accessible on the host.
    if ! usermod -u "$WWWUSER" -o sail; then
        echo "Unable to align the Sail UID with WWWUSER=$WWWUSER." >&2
        exit 1
    fi
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer
addgroup supervisor > /dev/null 2>&1
usermod -a -G supervisor sail > /dev/null 2>&1

# Run PHP-FPM as `sail` so its uid/gid match files written via the bind mount
# (host user = sail's primary group). Avoids "chmod(): Operation not permitted"
# on storage/logs when files were created by the host user or other processes.
# The FPM unix socket stays owned by www-data so nginx (running as www-data)
# can connect to it.
SAIL_GROUP="$(id -gn sail)"
cat > /etc/php/8.5/fpm/pool.d/zz-sail.conf <<EOF
[www]
user = sail
group = ${SAIL_GROUP}
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
EOF

# Vite is started separately with `make npm-dev`. A hot file left behind by a
# previous dev-server process makes Laravel request assets from a dead port.
unlink /var/www/html/public/hot 2>/dev/null || true

# Set timezone
ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Repair writable runtime directories left by containers that started before
# the Sail UID was aligned with the host user.
for d in storage/framework storage/logs bootstrap/cache; do
    if [ -d "/var/www/html/$d" ]; then
        chown -R sail:"${SAIL_GROUP}" "/var/www/html/$d" 2>/dev/null || true
        chmod -R ug+rwX "/var/www/html/$d" 2>/dev/null || true
    fi
done

if [ $# -gt 0 ]; then
    exec gosu $WWWUSER "$@"
else
    exec /usr/bin/supervisord --nodaemon -c /etc/supervisor/supervisord.conf
fi
