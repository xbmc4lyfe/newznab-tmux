#!/bin/sh
# Existing app containers (even stopped ones) always use the guarded migration rollout.
set -eu
DIR=$(cd "$(dirname "$0")/.." && pwd)
COMPOSE_FILE="${COMPOSE_FILE:-$DIR/docker-compose.yml}"
export COMPOSE_FILE
compose() { "$DIR/bin/compose" "$@"; }
existing=$(compose ps -a -q web horizon scheduler indexer)
if [ -n "$existing" ]; then
    exec "${JUST:-just}" --justfile "$DIR/Justfile" --working-directory "$DIR" deploy
fi
compose up -d
