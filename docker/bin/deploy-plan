#!/usr/bin/env python3
"""Per-service content fingerprinting and selective deployment planner for the docker/ stack."""

from __future__ import annotations

import hashlib
import json
import os
import shlex
import stat
import subprocess
import sys
from pathlib import Path

APP_SERVICES = ("web", "horizon", "scheduler", "indexer")
DATA_SERVICES = ("mariadb", "redis", "manticore")
INFRA_SERVICES = (
    "proxy",
    "mailpit",
    "prometheus",
    "pushgateway",
    "grafana",
    "node-exporter",
    "mysqld-exporter",
    "redis-exporter",
)
ALL_SERVICES = (*APP_SERVICES, *DATA_SERVICES, *INFRA_SERVICES)

SERVICE_TARGET = {
    "web": "selfhosted-web",
    "horizon": "selfhosted-horizon",
    "scheduler": "selfhosted-scheduler",
    "indexer": "selfhosted-indexer",
}

IGNORED_EXACT = {
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    ".prettierignore",
    ".prettierrc",
    ".vale-plugin.toml",
    "LICENSE",
    "Justfile",
    "Makefile",
    "boost.json",
    "captainhook.json",
    "commit",
    "debug_scrapers.php",
    "docker-compose.monitoring.yml",
    "docker-compose.yml.prod-dist",
    "docker-entrypoint.sh",
    "docker/Justfile",
    "docker/Makefile",
    "nntmux",
    "pint.json",
    "rector.php",
    "sail",
    "skills-lock.json",
}

IGNORED_PREFIXES = (
    ".agents/",
    ".ai/",
    ".claude/",
    ".codex/",
    ".cursor/",
    ".github/",
    ".idea/",
    ".junie/",
    ".phpunit",
    ".superpowers/",
    ".vscode/",
    "benchmarks/",
    "deploy/aws/",
    "deploy/cloud/tests/",
    "docker/.build.stamp",
    "docker/.deploy",
    "docker/backups/",
    "docker/data/",
    "docker/docs/",
    "docker/logs/",
    "docs/",
    "github-pages/",
    "infra/",
    "misc/",
    "phpstan",
    "phpunit.xml",
    "scripts/",
)

# Role-specific ownership is limited to inputs no other role can execute: static/Vite assets that
# only the web image serves, and files copied only into one role's image. Any PHP, config, route or
# view file can be reached from another role (queued jobs, scheduled commands, tmux scripts, service
# providers), so it stays shared-app and rebuilds all four app services.
WEB_ONLY_EXACT = {
    "docker/app/Caddyfile",
    "package-lock.json",
    "package.json",
    "tsconfig.json",
    "vite.config.js",
}

WEB_ONLY_PREFIXES = (
    "resources/css/",
    "resources/js/",
)

SCHEDULER_ONLY_EXACT = {
    "docker/app/bin/scheduler.py",
}

INDEXER_ONLY_EXACT = {
    "docker/app/bin/indexer.sh",
    "docker/app/php/yenc-ffi.ini",
}

# Bind-mounted service configuration. Deploy plans hash the files Compose actually mounts; these
# repository paths are only used to interpret a legacy one-line stamp.
LEGACY_CONFIG_OWNERS = (
    ("docker/config/caddy/", "proxy"),
    ("docker/config/prometheus/", "prometheus"),
    ("docker/monitoring/grafana/", "grafana"),
    ("docker/config/mariadb/", "mariadb"),
    ("docker/config/redis/", "redis"),
    ("docker/config/manticore/", "manticore"),
)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_text(text: str) -> str:
    return sha256_bytes(text.encode("utf-8", errors="surrogateescape"))


def classify_path(rel_path: str) -> tuple[str, ...]:
    """Return the logical ownership bucket(s) for a repository-relative path."""
    if rel_path == "tests/Fixtures/nzb-article-fingerprint/NzbArticleFingerprint.php":
        return ("shared-app",)
    if rel_path.endswith(".md") or rel_path in IGNORED_EXACT:
        return ()
    if rel_path.startswith("install") and rel_path.endswith(".sh"):
        return ()
    if any(rel_path.startswith(prefix) for prefix in IGNORED_PREFIXES):
        return ()
    if rel_path.startswith("tests/"):
        return ()
    if rel_path.startswith("docker/8.5/") and rel_path != "docker/8.5/php.ini":
        return ()
    if rel_path.startswith("docker/bin/"):
        return ()
    if rel_path == "docker/docker-compose.yml":
        # Tracked via rendered compose config --format json per service.
        return ()

    # Outside the image build context (.dockerignore). Runtime env files feed the configuration
    # hashes and mounted service configuration the rendered Compose bind sources.
    if rel_path.startswith(("docker/.env", "docker/config/", "docker/monitoring/")):
        return ()

    if rel_path.startswith("database/migrations/"):
        return ("migrations", "shared-app")
    if rel_path in WEB_ONLY_EXACT or any(rel_path.startswith(p) for p in WEB_ONLY_PREFIXES):
        return ("web",)
    if rel_path in SCHEDULER_ONLY_EXACT:
        return ("scheduler",)
    if rel_path in INDEXER_ONLY_EXACT:
        return ("indexer",)

    # Everything else (PHP, config, routes, views, composer, Dockerfile, ...) affects all 4 app services.
    return ("shared-app",)


def legacy_owners(rel_path: str) -> tuple[str, ...]:
    """Ownership for diffs against a legacy stamp, including mounted service configuration."""
    for prefix, owner in LEGACY_CONFIG_OWNERS:
        if rel_path.startswith(prefix):
            return (owner,)
    return classify_path(rel_path)


def file_record(repo: Path, rel_path: str) -> str:
    """Compute a deterministic content+mode+symlink record for a working-tree file."""
    full = repo / rel_path
    try:
        st = os.lstat(full)
    except OSError:
        return f"deleted {rel_path}"
    mode = f"{stat.S_IMODE(st.st_mode):04o}"
    if os.path.islink(full):
        target = os.readlink(full)
        try:
            target_bytes = full.read_bytes()
            content_hash = sha256_bytes(target_bytes)
        except OSError:
            content_hash = "dangling"
        return f"link {content_hash} {rel_path} -> {target}"
    if os.path.isfile(full):
        return f"file {mode} {sha256_bytes(full.read_bytes())} {rel_path}"
    return f"other {mode} {rel_path}"


def collect_repo_records(repo: Path) -> list[tuple[str, str]]:
    """Return sorted (rel_path, record_line) for all runtime files on disk in repo."""
    candidates: set[str] = set()
    ls_files = subprocess.run(
        ["git", "-C", str(repo), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
        capture_output=True,
        check=False,
    )
    if ls_files.returncode == 0:
        for raw in ls_files.stdout.split(b"\x00"):
            if raw:
                candidates.add(raw.decode("utf-8", errors="surrogateescape"))
        diff_head = subprocess.run(
            ["git", "-C", str(repo), "diff", "--name-only", "-z", "HEAD"],
            capture_output=True,
            check=False,
        )
        if diff_head.returncode == 0 and diff_head.stdout:
            for raw in diff_head.stdout.split(b"\x00"):
                if raw:
                    candidates.add(raw.decode("utf-8", errors="surrogateescape"))
    else:
        for path in sorted(repo.rglob("*")):
            if ".git" in path.parts:
                continue
            candidates.add(path.relative_to(repo).as_posix())

    records: list[tuple[str, str]] = []
    for rel_path in sorted(candidates):
        if not classify_path(rel_path):
            continue
        records.append((rel_path, file_record(repo, rel_path)))
    return records


def dockerfile_base_hash(repo: Path) -> str:
    dockerfile = repo / "Dockerfile"
    if not dockerfile.is_file():
        return "missing"
    text = dockerfile.read_text(encoding="utf-8", errors="surrogateescape")
    # Hash up through the end of the `FROM base-os AS base` stage
    marker = "FROM dunglas/frankenphp:1-php8.5-bookworm AS yenc"
    prefix = text.split(marker, 1)[0] if marker in text else text
    return sha256_text(prefix)


def compose_command(docker_dir: Path) -> list[str]:
    return [str(docker_dir / "bin/compose")]


def service_top_level_compose_deps(parsed: dict[str, object], svc_cfg: object) -> dict[str, object]:
    """Extract top-level networks, volumes, configs, secrets, and global keys referenced by a service."""
    if not isinstance(svc_cfg, dict):
        return {}
    deps: dict[str, object] = {}
    for section in ("networks", "volumes", "configs", "secrets"):
        top_sec = parsed.get(section)
        if not isinstance(top_sec, dict):
            continue
        svc_sec = svc_cfg.get(section)
        referenced: set[str] = set()
        if isinstance(svc_sec, dict):
            referenced.update(svc_sec.keys())
        elif isinstance(svc_sec, list):
            for item in svc_sec:
                if isinstance(item, str):
                    referenced.add(item.split(":", 1)[0])
                elif isinstance(item, dict):
                    src = item.get("source")
                    if isinstance(src, str):
                        referenced.add(src)
        elif section == "networks" and "default" in top_sec:
            referenced.add("default")
        if referenced:
            deps[section] = {k: top_sec[k] for k in sorted(referenced) if k in top_sec}
    for key, val in parsed.items():
        # `x-*` extension blocks are already merged into the services that reference them; hashing
        # them for every service would make an app-only edit recreate stateful services.
        if key not in ("services", "networks", "volumes", "configs", "secrets") and not key.startswith("x-"):
            deps[f"top:{key}"] = val
    return deps


def project_directory(docker_dir: Path) -> Path:
    try:
        argv = shlex.split(os.environ.get("DC", ""))
    except ValueError:
        argv = []
    for index, arg in enumerate(argv):
        if arg == "--project-directory" and index + 1 < len(argv):
            return Path(argv[index + 1]).resolve()
        if arg.startswith("--project-directory="):
            return Path(arg.split("=", 1)[1]).resolve()
    return docker_dir.resolve()


def bind_source_record(source: str, read_only: bool, project_dir: Path) -> str:
    """Content of a bind-mounted configuration source: any file, or a read-only directory inside the
    Compose project (data, log and host-system directories are not configuration)."""
    path = Path(source)
    try:
        if path.is_file():
            return f"file {sha256_bytes(path.read_bytes())} {source}"
        if not path.is_dir():
            return f"missing {source}"
        resolved = path.resolve()
        if not read_only or not resolved.is_relative_to(project_dir):
            return f"dir {source}"
        lines: list[str] = []
        for root, dirs, files in os.walk(resolved):
            dirs.sort()
            for name in sorted(files):
                full = Path(root) / name
                if len(lines) >= 2000:
                    return f"dir-too-large {source}"
                lines.append(f"{full.relative_to(resolved).as_posix()} {sha256_bytes(full.read_bytes())}")
        return f"tree {sha256_text(chr(10).join(lines))} {source}"
    except OSError as error:
        return f"unreadable {source} {error.errno}"


def service_bind_records(svc_cfg: object, project_dir: Path) -> list[str]:
    if not isinstance(svc_cfg, dict) or not isinstance(svc_cfg.get("volumes"), list):
        return []
    records: list[str] = []
    for volume in svc_cfg["volumes"]:
        if isinstance(volume, dict) and volume.get("type") == "bind" and isinstance(volume.get("source"), str):
            records.append(bind_source_record(volume["source"], bool(volume.get("read_only")), project_dir))
    return records


def get_compose_service_hashes(docker_dir: Path) -> tuple[str, dict[str, str]]:
    """Return (global_config_hash, per_service_config_hashes)."""
    env = dict(os.environ)
    env.setdefault("COMPOSE_FILE", str(docker_dir / "docker-compose.yml"))
    proc = subprocess.run(
        [*compose_command(docker_dir), "config", "--format", "json"],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr)
        sys.exit(proc.returncode or 1)
    raw = proc.stdout.strip()
    context_meta = f"{os.environ.get('DC', '')}\n{os.environ.get('DOCKER_CONTEXT', '')}\n{os.environ.get('DOCKER_HOST', '')}"
    global_hash = sha256_text(f"{raw}\n{context_meta}")
    per_service: dict[str, str] = {}
    project_dir = project_directory(docker_dir)
    try:
        parsed = json.loads(raw)
        if isinstance(parsed, dict) and isinstance(parsed.get("services"), dict):
            services_map = parsed["services"]
            # Services outside the known roster are stateless infrastructure by default, so an
            # added Compose service is started rather than silently stamped as deployed.
            for svc in sorted(set(ALL_SERVICES) | set(services_map)):
                if svc in services_map:
                    # The Compose command text and context only feed the global hash: an equivalent
                    # rendering must not drain writers or recreate stateful services.
                    svc_payload = {
                        "service": services_map[svc],
                        "top_level": service_top_level_compose_deps(parsed, services_map[svc]),
                        "mounted": service_bind_records(services_map[svc], project_dir),
                    }
                    svc_json = json.dumps(svc_payload, sort_keys=True)
                    per_service[svc] = sha256_text(svc_json)
                else:
                    per_service[svc] = "absent"
            return global_hash, per_service
    except (ValueError, TypeError):
        pass
    for svc in ALL_SERVICES:
        per_service[svc] = global_hash
    return global_hash, per_service


def service_image_name(svc: str) -> str:
    env_key = f"{svc.upper()}_IMAGE"
    default_role_img = f"nntmux/{svc}:local"
    role_img = os.environ.get(env_key, "")
    app_img = os.environ.get("APP_IMAGE", "")
    if role_img and (role_img != default_role_img or not app_img or app_img == "nntmux/app:local"):
        return role_img
    if app_img and app_img != "nntmux/app:local":
        return app_img
    return default_role_img


def compute_state(repo: Path, docker_dir: Path, include_compose: bool) -> dict[str, str]:
    buckets: dict[str, list[str]] = {
        "shared-app": [],
        "migrations": [],
        **{svc: [] for svc in ALL_SERVICES},
    }
    runtime_records: list[str] = []

    for rel_path, record in collect_repo_records(repo):
        owners = classify_path(rel_path)
        if not owners:
            continue
        runtime_records.append(record)
        for owner in owners:
            if owner in buckets:
                buckets[owner].append(record)

    env_hashes: list[str] = []
    for env_file in (docker_dir / ".env", docker_dir / "config/app.env"):
        if env_file.is_file():
            env_hashes.append(sha256_bytes(env_file.read_bytes()))
        else:
            env_hashes.append("missing")
    base_img = os.environ.get("BASE_IMAGE", "nntmux/base:local")
    image_tags = [base_img, *(service_image_name(svc) for svc in APP_SERVICES)]
    configuration_hash = sha256_text("\n".join([*env_hashes, *image_tags]))
    app_env_hash = env_hashes[1]

    effective_hash = "none"
    per_service_compose: dict[str, str] = {svc: "none" for svc in ALL_SERVICES}
    compose_rendered = False
    config_cmd = os.environ.get("DEPLOY_CONFIG_COMMAND", "")
    if config_cmd:
        proc = subprocess.run([config_cmd, "--fingerprint"], capture_output=True, text=True, check=False)
        if proc.returncode != 0:
            sys.stderr.write(proc.stderr)
            sys.exit(proc.returncode or 1)
        effective_hash = proc.stdout.strip()
        if Path(config_cmd).name == "deploy-current":
            # Mounted configuration contents are not part of the rendered Compose text; fold them in
            # so a changed bind-mounted file is never skipped as an unchanged deployment.
            _, per_service_compose = get_compose_service_hashes(docker_dir)
            compose_rendered = True
            mounted = json.dumps(per_service_compose, sort_keys=True)
            effective_hash = sha256_text(f"{effective_hash}\n{mounted}")
        elif include_compose:
            per_service_compose = {svc: effective_hash for svc in ALL_SERVICES}
    elif include_compose:
        effective_hash, per_service_compose = get_compose_service_hashes(docker_dir)
        compose_rendered = True

    runtime_tree_hash = sha256_text("\n".join(runtime_records))
    shared_app_hash = sha256_text("\n".join(buckets["shared-app"]))
    migration_hash = sha256_text("\n".join(buckets["migrations"]))
    base_hash = sha256_text(f"{dockerfile_base_hash(repo)}\n{base_img}")

    state: dict[str, str] = {
        "fingerprint": f"{runtime_tree_hash} {configuration_hash} {effective_hash}",
        "base": base_hash,
        "migration": migration_hash,
        "shared_app": shared_app_hash,
        "app_env": app_env_hash,
        "effective": effective_hash,
    }

    for svc in APP_SERVICES:
        img = service_image_name(svc)
        svc_files_hash = sha256_text("\n".join(buckets[svc]))
        build_hash = sha256_text(f"{base_hash}\n{shared_app_hash}\n{svc_files_hash}\n{img}")
        deploy_hash = sha256_text(f"{build_hash}\n{app_env_hash}\n{per_service_compose[svc]}")
        state[f"build:{svc}"] = build_hash
        state[f"service:{svc}"] = deploy_hash

    extra_infra = sorted(set(per_service_compose) - set(ALL_SERVICES)) if compose_rendered else []
    for svc in (*DATA_SERVICES, *INFRA_SERVICES, *extra_infra):
        svc_files_hash = sha256_text("\n".join(buckets.get(svc, [])))
        deploy_hash = sha256_text(f"{svc_files_hash}\n{per_service_compose[svc]}")
        state[f"service:{svc}"] = deploy_hash
        if per_service_compose[svc] == "absent":
            state[f"compose:{svc}"] = "absent"

    return state


def parse_stamp(stamp_path: Path) -> dict[str, str]:
    if not stamp_path.is_file():
        return {}
    lines = [line.strip() for line in stamp_path.read_text(encoding="utf-8", errors="surrogateescape").splitlines() if line.strip()]
    if not lines:
        return {}
    parsed: dict[str, str] = {"fingerprint": lines[0]}
    has_kv = False
    for line in lines[1:]:
        if "=" in line:
            has_kv = True
            k, _, v = line.partition("=")
            parsed[k.strip()] = v.strip()
    if not has_kv:
        parsed["__legacy__"] = "1"
        tokens = lines[0].split()
        if len(tokens) >= 3:
            parsed["effective"] = tokens[2]
    return parsed


def format_stamp(state: dict[str, str]) -> str:
    stamped = dict(state)
    base_img = os.environ.get("BASE_IMAGE", "nntmux/base:local")
    base_id = image_id(base_img)
    if base_id:
        stamped["image:base"] = f"{base_img}@{base_id}"
    for svc in APP_SERVICES:
        img = service_image_name(svc)
        svc_id = image_id(img)
        if svc_id:
            stamped[f"image:{svc}"] = f"{img}@{svc_id}"
    lines = [stamped["fingerprint"]]
    for key in sorted(k for k in stamped if k != "fingerprint"):
        lines.append(f"{key}={stamped[key]}")
    return "\n".join(lines) + "\n"


def image_exists(image: str) -> bool:
    proc = subprocess.run(
        ["docker", "image", "inspect", image],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return proc.returncode == 0


def image_id(image: str) -> str | None:
    proc = subprocess.run(
        ["docker", "image", "inspect", "--format", "{{.Id}}", image],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.strip()


def check_app_container(docker_dir: Path, svc: str, verify_image: bool = True) -> tuple[bool, str]:
    """Return (is_ok, reason) for a running app service container."""
    env = dict(os.environ)
    env.setdefault("COMPOSE_FILE", str(docker_dir / "docker-compose.yml"))
    ps = subprocess.run(
        [*compose_command(docker_dir), "ps", "-q", svc],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if ps.returncode != 0 or not ps.stdout.strip():
        return False, "missing"
    container = ps.stdout.strip().splitlines()[0]
    status_proc = subprocess.run(
        ["docker", "inspect", "--format", "{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}", container],
        capture_output=True,
        text=True,
        check=False,
    )
    if status_proc.returncode != 0 or status_proc.stdout.strip() != "running healthy":
        return False, f"unhealthy ({status_proc.stdout.strip() or 'inspect-failed'})"
    if verify_image:
        expected = image_id(service_image_name(svc))
        if not expected:
            return False, "missing-image"
        img_proc = subprocess.run(
            ["docker", "inspect", "--format", "{{.Image}}", container],
            capture_output=True,
            text=True,
            check=False,
        )
        if img_proc.returncode != 0 or img_proc.stdout.strip() != expected:
            return False, "stale-image"
    return True, "healthy"


def running_image(docker_dir: Path, svc: str) -> str | None:
    env = dict(os.environ)
    env.setdefault("COMPOSE_FILE", str(docker_dir / "docker-compose.yml"))
    ps = subprocess.run([*compose_command(docker_dir), "ps", "-q", svc], capture_output=True, text=True, env=env, check=False)
    if ps.returncode != 0 or not ps.stdout.strip():
        return None
    container = ps.stdout.strip().splitlines()[0]
    proc = subprocess.run(["docker", "inspect", "--format", "{{.Image}}", container], capture_output=True, text=True, check=False)
    return proc.stdout.strip() if proc.returncode == 0 else None


def recent_dirty_buckets(repo: Path, stamped_fingerprint: str = "") -> set[str] | None:
    """Ownership buckets modified since a legacy stamp's revision, or None when it cannot be diffed."""
    tokens = stamped_fingerprint.split()
    base_rev = tokens[0] if tokens else ""
    if not base_rev:
        return None
    verify = subprocess.run(
        ["git", "-C", str(repo), "rev-parse", "--verify", "--quiet", f"{base_rev}^{{commit}}"],
        capture_output=True,
        check=False,
    )
    if verify.returncode != 0:
        return None
    buckets: set[str] = set()
    cmds = [
        ["git", "-C", str(repo), "diff", "--name-only", "-z", base_rev, "HEAD"],
        ["git", "-C", str(repo), "diff", "--name-only", "-z", "HEAD"],
        ["git", "-C", str(repo), "ls-files", "-o", "--exclude-standard", "-z"],
    ]
    for cmd in cmds:
        proc = subprocess.run(cmd, capture_output=True, check=False)
        if proc.returncode != 0:
            return None
        if proc.stdout:
            for raw in proc.stdout.split(b"\x00"):
                if raw:
                    rel_path = raw.decode("utf-8", errors="surrogateescape")
                    buckets.update(legacy_owners(rel_path))
    return buckets


def compute_build_targets(repo: Path, docker_dir: Path, stamp_path: Path) -> list[str]:
    state = compute_state(repo, docker_dir, include_compose=False)
    stamped = parse_stamp(stamp_path)
    force = os.environ.get("FORCE", "0") == "1"

    targets: list[str] = []
    base_img = os.environ.get("BASE_IMAGE", "nntmux/base:local")
    base_id = image_id(base_img)
    if (
        force
        or stamped.get("base") != state["base"]
        or not base_id
        or stamped.get("image:base") != f"{base_img}@{base_id}"
    ):
        targets.append("base")

    for svc in APP_SERVICES:
        img = service_image_name(svc)
        svc_id = image_id(img)
        if (
            force
            or f"build:{svc}" not in stamped
            or stamped.get(f"build:{svc}") != state[f"build:{svc}"]
            or not svc_id
            or stamped.get(f"image:{svc}") != f"{img}@{svc_id}"
        ):
            targets.append(svc)

    return targets


def infra_services(state: dict[str, str]) -> list[str]:
    """Known infrastructure plus any additional service rendered by the effective Compose files."""
    rendered = {key.split(":", 1)[1] for key in state if key.startswith("service:")}
    extra = sorted(rendered - set(ALL_SERVICES))
    return [*INFRA_SERVICES, *extra]


def compose_present(state: dict[str, str], svc: str) -> bool:
    """False when the effective Compose configuration does not render this service."""
    return state.get(f"compose:{svc}", "none") != "absent"


def compute_deploy_plan(repo: Path, docker_dir: Path, stamp_path: Path) -> dict[str, object]:
    state = compute_state(repo, docker_dir, include_compose=True)
    stamped = parse_stamp(stamp_path)
    force = os.environ.get("FORCE", "0") == "1"
    first_deploy = not bool(stamped)
    legacy_stamp = "__legacy__" in stamped
    legacy_buckets = recent_dirty_buckets(repo, stamped.get("fingerprint", "")) if legacy_stamp else set()
    # A legacy stamp records neither per-service Compose state nor mounted file contents, so Compose
    # reconciles every rendered data and infra service (recreating only real drift, never forcing).
    # Repository edits to mounted configuration since a diffable stamped revision still force a recreate.

    dirty_app: list[str] = []
    app_reasons: dict[str, str] = {}
    any_missing_or_unhealthy = False

    for svc in APP_SERVICES:
        ok, reason = check_app_container(docker_dir, svc, verify_image=True)
        if not ok and (reason == "missing" or reason.startswith("unhealthy")):
            any_missing_or_unhealthy = True
        if force:
            dirty_app.append(svc)
            app_reasons[svc] = "forced (FORCE=1)"
        elif first_deploy:
            dirty_app.append(svc)
            app_reasons[svc] = "initial deployment"
        elif legacy_stamp:
            dirty_app.append(svc)
            app_reasons[svc] = "legacy stamp upgrade"
        elif stamped.get(f"service:{svc}") != state[f"service:{svc}"]:
            dirty_app.append(svc)
            app_reasons[svc] = "code/config changed"
        elif f"image:{svc}" not in stamped or running_image(docker_dir, svc) != stamped[f"image:{svc}"].rsplit("@", 1)[-1]:
            # The running container must be the exact image recorded by the last verified rollout.
            dirty_app.append(svc)
            app_reasons[svc] = "running image differs from stamp"
        elif not ok:
            dirty_app.append(svc)
            app_reasons[svc] = reason
        else:
            app_reasons[svc] = "unchanged"

    dirty_data: list[str] = []
    reconcile_data: list[str] = []
    data_reasons: dict[str, str] = {}
    for svc in DATA_SERVICES:
        if not compose_present(state, svc):
            data_reasons[svc] = "not rendered"
        elif legacy_stamp and legacy_buckets is not None and svc in legacy_buckets:
            dirty_data.append(svc)
            data_reasons[svc] = "config changed since legacy stamp"
        elif first_deploy or legacy_stamp:
            # No per-service record: Compose reconciles drift while writers are stopped, without
            # force-recreating stateful services.
            reconcile_data.append(svc)
            data_reasons[svc] = "reconcile (no stamp)" if first_deploy else "reconcile (legacy stamp)"
        elif stamped.get(f"service:{svc}") != state[f"service:{svc}"]:
            dirty_data.append(svc)
            data_reasons[svc] = "config/compose changed"
        else:
            data_reasons[svc] = "unchanged"

    dirty_infra: list[str] = []
    reconcile_infra: list[str] = []
    infra_reasons: dict[str, str] = {}
    for svc in infra_services(state):
        if not compose_present(state, svc):
            infra_reasons[svc] = "not rendered"
        elif first_deploy:
            # Stateless: recreate so mounted configuration matches what gets stamped.
            dirty_infra.append(svc)
            infra_reasons[svc] = "recreate (no stamp)"
        elif legacy_stamp and legacy_buckets is not None and svc in legacy_buckets:
            dirty_infra.append(svc)
            infra_reasons[svc] = "config changed since legacy stamp"
        elif legacy_stamp:
            reconcile_infra.append(svc)
            infra_reasons[svc] = "reconcile (legacy stamp)"
        elif f"service:{svc}" not in stamped:
            dirty_infra.append(svc)
            infra_reasons[svc] = "added to Compose"
        elif stamped.get(f"service:{svc}") != state[f"service:{svc}"]:
            dirty_infra.append(svc)
            infra_reasons[svc] = "config/compose changed"
        else:
            infra_reasons[svc] = "unchanged"

    compose_global_changed = not first_deploy and stamped.get("effective") != state["effective"]
    if compose_global_changed and not dirty_app and not dirty_data and not dirty_infra:
        for svc in APP_SERVICES:
            dirty_app.append(svc)
            app_reasons[svc] = "compose config changed"
    # If all 4 app services changed due to a global compose config change, run migrations too
    all_app_compose_changed = compose_global_changed and len(dirty_app) == len(APP_SERVICES)

    migrate = (
        force
        or first_deploy
        or legacy_stamp
        or any_missing_or_unhealthy
        or stamped.get("migration") != state["migration"]
        or all_app_compose_changed
    )

    if not dirty_app and not dirty_data and not dirty_infra and not migrate:
        mode = "noop"
    elif migrate or dirty_data:
        mode = "full"
        for svc in APP_SERVICES:
            if svc not in dirty_app:
                dirty_app.append(svc)
                if app_reasons.get(svc) == "unchanged":
                    app_reasons[svc] = "migration quiesce" if migrate else "data service restart"
    else:
        mode = "selective"

    build_targets = compute_build_targets(repo, docker_dir, Path(os.environ.get("DEPLOY_BUILD_STAMP", docker_dir / ".build.stamp")))

    return {
        "mode": mode,
        "migrate": migrate,
        "dirty_app": dirty_app,
        "dirty_data": dirty_data,
        "dirty_infra": dirty_infra,
        "reconcile_data": reconcile_data,
        "reconcile_infra": reconcile_infra,
        "build_targets": build_targets,
        "app_reasons": app_reasons,
        "data_reasons": data_reasons,
        "infra_reasons": infra_reasons,
        "state": state,
    }


def main() -> None:
    docker_dir = Path(__file__).resolve().parent.parent
    repo = Path(os.environ.get("DEPLOY_REPO", docker_dir.parent)).resolve()
    stamp_path = Path(os.environ.get("DEPLOY_STAMP", docker_dir / ".deploy.stamp"))

    cmd = sys.argv[1] if len(sys.argv) > 1 else "--explain"

    if cmd == "--fingerprint":
        state = compute_state(repo, docker_dir, include_compose=False)
        print(state["fingerprint"])
        return

    if cmd == "--stamp-data":
        include_compose = bool(os.environ.get("DEPLOY_CONFIG_COMMAND", "")) or (len(sys.argv) > 2 and sys.argv[2] == "deploy")
        state = compute_state(repo, docker_dir, include_compose=include_compose)
        sys.stdout.write(format_stamp(state))
        return

    if cmd == "--build-targets":
        build_stamp = Path(os.environ.get("DEPLOY_STAMP", docker_dir / ".build.stamp"))
        targets = compute_build_targets(repo, docker_dir, build_stamp)
        print(" ".join(targets))
        return

    if cmd == "--deploy-actions":
        plan = compute_deploy_plan(repo, docker_dir, stamp_path)
        print(f"MODE={shlex.quote(str(plan['mode']))}")
        print(f"MIGRATE={'1' if plan['migrate'] else '0'}")
        print(f"DIRTY_APP={shlex.quote(' '.join(plan['dirty_app']))}")
        print(f"DIRTY_DATA={shlex.quote(' '.join(plan['dirty_data']))}")
        print(f"DIRTY_INFRA={shlex.quote(' '.join(plan['dirty_infra']))}")
        print(f"RECONCILE_DATA={shlex.quote(' '.join(plan['reconcile_data']))}")
        print(f"RECONCILE_INFRA={shlex.quote(' '.join(plan['reconcile_infra']))}")
        print(f"BUILD_TARGETS={shlex.quote(' '.join(plan['build_targets']))}")
        return

    if cmd == "--explain":
        plan = compute_deploy_plan(repo, docker_dir, stamp_path)
        print(f"Deployment Mode : {plan['mode']}")
        print(f"Build Targets   : {', '.join(plan['build_targets']) if plan['build_targets'] else 'none (all cached)'}")
        print(f"Run Migrations  : {'yes (full writer quiesce)' if plan['migrate'] else 'no'}")
        print("")
        print(f"{'Service':<18} {'Category':<10} {'Action':<18} {'Reason'}")
        print("-" * 72)
        for svc in APP_SERVICES:
            reason = plan["app_reasons"][svc]
            if reason in ("migration quiesce", "data service restart"):
                action = "quiesce+restart"
            elif svc in plan["dirty_app"]:
                action = "recreate" if svc == "web" else "drain+recreate"
            else:
                action = "skip"
            print(f"{svc:<18} {'app':<10} {action:<18} {reason}")
        for svc in DATA_SERVICES:
            if svc in plan["dirty_data"]:
                action = "drain+recreate"
            elif svc in plan["reconcile_data"]:
                action = "reconcile"
            else:
                action = "skip"
            print(f"{svc:<18} {'data':<10} {action:<18} {plan['data_reasons'][svc]}")
        for svc in plan["infra_reasons"]:
            if svc in plan["dirty_infra"]:
                action = "recreate"
            elif svc in plan["reconcile_infra"]:
                action = "reconcile"
            else:
                action = "skip"
            print(f"{svc:<18} {'infra':<10} {action:<18} {plan['infra_reasons'][svc]}")
        return

    sys.exit(f"Unknown option: {cmd}")


if __name__ == "__main__":
    main()
