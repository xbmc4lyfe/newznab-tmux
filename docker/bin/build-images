#!/bin/sh
# Build only the Docker targets whose inputs changed since the last .build.stamp.
set -eu
DIR=$(cd "$(dirname "$0")/.." && pwd)
REPO="${DEPLOY_REPO:-$(cd "$DIR/.." && pwd)}"

BASE_IMAGE="${BASE_IMAGE:-nntmux/base:local}"
APP_IMAGE="${APP_IMAGE:-nntmux/app:local}"
if [ "$APP_IMAGE" != "nntmux/app:local" ]; then
    WEB_IMAGE="${WEB_IMAGE:-$APP_IMAGE}"
    HORIZON_IMAGE="${HORIZON_IMAGE:-$APP_IMAGE}"
    SCHEDULER_IMAGE="${SCHEDULER_IMAGE:-$APP_IMAGE}"
    INDEXER_IMAGE="${INDEXER_IMAGE:-$APP_IMAGE}"
else
    WEB_IMAGE="${WEB_IMAGE:-nntmux/web:local}"
    HORIZON_IMAGE="${HORIZON_IMAGE:-nntmux/horizon:local}"
    SCHEDULER_IMAGE="${SCHEDULER_IMAGE:-nntmux/scheduler:local}"
    INDEXER_IMAGE="${INDEXER_IMAGE:-nntmux/indexer:local}"
fi
export BASE_IMAGE APP_IMAGE WEB_IMAGE HORIZON_IMAGE SCHEDULER_IMAGE INDEXER_IMAGE

targets=$(DEPLOY_STAMP="${DEPLOY_STAMP:-$DIR/.build.stamp}" "$DIR/bin/deploy-plan" --build-targets)
[ -n "$targets" ] || exit 0

shared_tag=0
if [ "$WEB_IMAGE" = "$HORIZON_IMAGE" ] || [ "$WEB_IMAGE" = "$SCHEDULER_IMAGE" ] || [ "$WEB_IMAGE" = "$INDEXER_IMAGE" ] \
    || [ "$HORIZON_IMAGE" = "$SCHEDULER_IMAGE" ] || [ "$HORIZON_IMAGE" = "$INDEXER_IMAGE" ] || [ "$SCHEDULER_IMAGE" = "$INDEXER_IMAGE" ]; then
    shared_tag=1
fi

built_shared=0
for target in $targets; do
    case "$target" in
        base)
            docker build --target base -t "$BASE_IMAGE" -f "$REPO/Dockerfile" "$REPO"
            ;;
        web|horizon|scheduler|indexer)
            if [ "$shared_tag" = 1 ]; then
                if [ "$built_shared" = 0 ]; then
                    docker build --target selfhosted -t "$WEB_IMAGE" -f "$REPO/Dockerfile" "$REPO"
                    built_shared=1
                fi
            else
                case "$target" in
                    web) docker build --target selfhosted-web -t "$WEB_IMAGE" -f "$REPO/Dockerfile" "$REPO" ;;
                    horizon) docker build --target selfhosted-horizon -t "$HORIZON_IMAGE" -f "$REPO/Dockerfile" "$REPO" ;;
                    scheduler) docker build --target selfhosted-scheduler -t "$SCHEDULER_IMAGE" -f "$REPO/Dockerfile" "$REPO" ;;
                    indexer) docker build --target selfhosted-indexer -t "$INDEXER_IMAGE" -f "$REPO/Dockerfile" "$REPO" ;;
                esac
            fi
            ;;
    esac
done
