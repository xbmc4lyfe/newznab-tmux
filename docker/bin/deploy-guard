#!/bin/sh
# Deploy guard for the docker/ stack: one deploy at a time, a log of who deployed what, and no
# rebuild when nothing runtime-relevant changed.
#
#   deploy-guard run <target> -- <command...>
#   deploy-guard verify    exit 76 if the tree changed since the last stamped build (nothing stamped is fine)
#   deploy-guard verify-owner    verify the inherited live guard and any recovery hold without changing them
#
# A guarded command may run another guarded command (just deploy runs build and up): the inner run
# verifies its ancestor's exact lock generation and neither takes nor releases it.
# A durable <lock>.recovery-hold blocks new runs even after that owner dies. Only the same live
# guard and DEPLOY_RECOVERY_OPERATION may continue; the recovery owner creates and clears the hold.
#
# Environment:
#   DEPLOY_BY            who is deploying (a session or person name); logged. Default: the login user.
#   SKIP_IF_UNCHANGED=1  skip the command when the runtime tree matches the last stamped deploy.
#   STAMP_ON_SUCCESS=1   record the per-service tree fingerprint after the command succeeds.
#   REQUIRE_IMAGE=<refs> with SKIP_IF_UNCHANGED, only skip while these docker images still exist.
#   FORCE=1              never skip or defer.
#   CHECK_UNCHANGED_COMMAND executable verifying the running image and service health.
#   CHECK_HEALTH_COMMAND executable checking health (--healthy), before batching.
#   DEPLOY_MIN_INTERVAL  batch until this many seconds after the last healthy rollout.
#   RECORD_DEPLOY_TIME=1 write DEPLOY_SUCCESS_TIME only after a successful rollout.
#   DEPLOY_LOCK_DIR, DEPLOY_LOG, DEPLOY_STAMP, DEPLOY_REPO  override the default paths (tests).
#
# Exit status: the command's; 75 when another deploy holds the lock; 76 when the checkout changed while a
# STAMP_ON_SUCCESS command ran (the result is stale, so nothing downstream should use it).
set -eu
# The log, stamp and lock are shared by everyone who deploys from this checkout.
umask 0002

DIR=$(cd "$(dirname "$0")/.." && pwd)
REPO="${DEPLOY_REPO:-$(cd "$DIR/.." && pwd)}"
export DEPLOY_REPO="$REPO"
LOCK="${DEPLOY_LOCK_DIR:-$DIR/.deploy.lock}"
lock_parent=$(cd "$(dirname "$LOCK")" && pwd -P) || {
    echo "deploy-guard: cannot resolve the lock parent; leaving the stack alone." >&2
    exit 74
}
LOCK="$lock_parent/$(basename "$LOCK")"
CLAIM="$LOCK.claim"
HOLD="$LOCK.recovery-hold"
LOG="${DEPLOY_LOG:-$DIR/.deploy.log}"
STAMP="${DEPLOY_STAMP:-$DIR/.deploy.stamp}"
SUCCESS_TIME="${DEPLOY_SUCCESS_TIME:-$DIR/.deploy.time}"
WHO=$(id -un 2>/dev/null || id -u)
BY="${DEPLOY_BY:-$WHO}"

hash_stdin() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi | cut -d' ' -f1
}

# Content-addressed runtime fingerprint (excludes documentation, tests, and non-runtime files).
fingerprint() {
    "$DIR/bin/deploy-plan" --fingerprint
}

log() {
    printf '%s %s by=%s user=%s head=%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$1" "$BY" "$WHO" \
        "$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)" "${2:-}" >>"$LOG"
}

# The lock is a symlink whose target text is the owner (pid, who, what, since). Creating a symlink is
# atomic and carries its content from the first instant, so there is never a lock without an owner.
lock_info() {
    readlink "$LOCK" 2>/dev/null || true
}

info_pid() {
    printf '%s' "$1" | sed -n 's/^pid=\([0-9][0-9]*\).*/\1/p'
}

# `ps -p` works for another user's process too; `kill -0` fails with EPERM there and would make a live
# owner look dead.
# When a process started, with spaces turned into underscores; empty if the process does not exist.
process_start() {
    ps -o lstart= -p "$1" 2>/dev/null | tr -s ' ' '_' | tr -d '\n'
}

# True while the lock owner described by $1 (the lock text) is still the same process: its pid exists
# and, when the lock recorded a start time, it started then. A reused pid has a different start time.
owner_alive() {
    pid=$(info_pid "$1")
    [ -n "$pid" ] || return 1
    ps -p "$pid" >/dev/null 2>&1 || return 1
    recorded=$(printf '%s' "$1" | sed -n 's/.* start=\([^ ]*\).*/\1/p')
    [ -z "$recorded" ] || [ "$recorded" = "$(process_start "$pid")" ]
}

release() {
    # Serialize the comparison and its removal child with every lock acquisition/reclaim. If the
    # owner dies while that child is running, the claim stays: no new generation can be installed.
    if ! mkdir "$CLAIM" 2>/dev/null; then
        echo "deploy-guard: lock mutation is claimed; leaving the owner record for later recovery." >&2
        return 0
    fi
    if [ "$(lock_info)" = "$owned_info" ]; then
        rm -f "$LOCK" || return 1
    fi
    rmdir "$CLAIM"
}

# EXIT trap of a guarded run: close an attempt that ends early (error, signal) with its own
# `finished` line, then release a lock this process owns.
guard_exit() {
    exit_code=$?
    if [ "${attempt_open:-0}" = 1 ]; then
        attempt_open=0
        log "$target" "result=finished rc=$exit_code (interrupted)"
    fi
    if [ -n "${owned_info:-}" ]; then
        release
    fi
}

busy() {
    echo "deploy-guard: another deploy is running ($1); leaving the stack alone." >&2
    exit 75
}

# An inherited PID is not ownership: a sibling can have copied environment variables. Require the
# exact lock/path/generation and a bounded real ancestor chain on both macOS and Linux.
nested_owner() {
    [ -n "${DEPLOY_GUARD_HELD:-}" ] && [ "${DEPLOY_GUARD_LOCK:-}" = "$LOCK" ] || return 1
    nested_info=$(lock_info)
    [ "$(info_pid "$nested_info")" = "$DEPLOY_GUARD_HELD" ] || return 1
    owner_alive "$nested_info" || return 1
    owner_generation=$(printf '%s' "$nested_info" | sed -n 's/.* generation=\([^ ]*\)$/\1/p')
    [ "${#owner_generation}" -eq 32 ] || return 1
    case "$owner_generation" in *[!a-f0-9]*) return 1;; esac
    owner_digest=$(printf '%s\n' "$nested_info" | hash_stdin)
    [ "${DEPLOY_GUARD_OWNER_SHA256:-}" = "$owner_digest" ] || return 1
    ancestor=$$
    depth=0
    while [ "$depth" -lt 128 ]; do
        ancestor=$(ps -o ppid= -p "$ancestor" 2>/dev/null | tr -d '[:space:]')
        case "$ancestor" in ''|*[!0-9]*) return 1;; esac
        [ "$ancestor" = "$DEPLOY_GUARD_HELD" ] && return 0
        [ "$ancestor" -gt 1 ] || return 1
        depth=$((depth + 1))
    done
    return 1
}

recovery_busy() {
    echo "deploy-guard: a recovery hold requires its exact live owner and operation; leaving the stack alone ($HOLD)." >&2
    exit 75
}

check_recovery_hold() {
    # -e alone misses a dangling symlink. Every nonregular or unreadable object is also a hold.
    if [ ! -e "$HOLD" ] && [ ! -L "$HOLD" ]; then return 0; fi
    [ -f "$HOLD" ] && [ ! -L "$HOLD" ] && [ -r "$HOLD" ] || recovery_busy
    nested_owner || recovery_busy
    operation=${DEPLOY_RECOVERY_OPERATION:-}
    [ "${#operation}" -ge 1 ] && [ "${#operation}" -le 128 ] || recovery_busy
    case "$operation" in *[!A-Za-z0-9_-]*) recovery_busy;; esac
    # Compare exact bytes, including the final newline; never accept a partial or extended record.
    printf 'v1\nowner_sha256=%s\noperation=%s\n' "$DEPLOY_GUARD_OWNER_SHA256" "$operation" \
        | cmp -s - "$HOLD" || recovery_busy
}

# Every mutation uses the same short-lived claim directory, including creation and release. Never
# reclaim a claim by age or parent death: an orphaned filesystem child may still be about to act.
# An interrupted mutation therefore requires explicit recovery; an ordinary payload crash still
# permits stale owner reclamation once no mutation is claimed.
acquire() {
    target=$1
    generation=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    [ "${#generation}" -eq 32 ] || { echo "deploy-guard: cannot create an ownership generation" >&2; exit 74; }
    case "$generation" in *[!a-f0-9]*) echo "deploy-guard: invalid ownership generation" >&2; exit 74;; esac
    stack_digest=$(printf '%s\n' "$LOCK" | hash_stdin)
    info="pid=$$ by=$BY target=$target since=$(date -u '+%Y-%m-%dT%H:%M:%SZ') start=$(process_start "$$") stack=$stack_digest generation=$generation"
    attempts=0
    while [ "$attempts" -lt 10 ]; do
        attempts=$((attempts + 1))
        check_recovery_hold
        if mkdir "$CLAIM" 2>/dev/null; then
            # ln treats an existing real directory as a destination directory. Refuse any
            # non-symlink lock path while holding the mutation claim, preserving its contents.
            if [ -e "$LOCK" ] && [ ! -L "$LOCK" ]; then
                rmdir "$CLAIM"
                busy "invalid non-symlink lock path"
            fi
            if ln -sn "$info" "$LOCK" 2>/dev/null; then
                rmdir "$CLAIM"
                return 0
            fi
            seen=$(lock_info)
            if owner_alive "$seen"; then
                rmdir "$CLAIM"
                busy "$seen"
            fi
            if [ -n "$seen" ] && [ "$(lock_info)" = "$seen" ] && ! owner_alive "$seen"; then
                echo "deploy-guard: removing a stale lock" >&2
                rm -f "$LOCK"
            fi
            rmdir "$CLAIM"
        else
            sleep 0.3
        fi
    done
    busy "$(lock_info)"
}

unchanged() {
    [ "${FORCE:-0}" != 1 ] || return 1
    [ "${SKIP_IF_UNCHANGED:-0}" = 1 ] || return 1
    [ -f "$STAMP" ] || return 1
    [ "$(head -n 1 "$STAMP")" = "$(fingerprint)" ] || return 1
    if [ -n "${REQUIRE_IMAGE:-}" ]; then
        for req_img in $REQUIRE_IMAGE; do
            docker image inspect "$req_img" >/dev/null 2>&1 || return 1
        done
        if [ "${target:-}" = "build" ]; then
            # A failing planner is not "nothing to build".
            build_targets=$(DEPLOY_STAMP="$STAMP" "$DIR/bin/deploy-plan" --build-targets) || return 1
            [ -z "$build_targets" ] || return 1
        fi
    fi
    if [ -n "${CHECK_UNCHANGED_COMMAND:-}" ]; then
        "$CHECK_UNCHANGED_COMMAND" || return 1
    fi
}

cooldown() {
    [ "${FORCE:-0}" != 1 ] || return 1
    interval=${DEPLOY_MIN_INTERVAL:-0}
    case "$interval" in ''|*[!0-9]*) echo "deploy-guard: DEPLOY_MIN_INTERVAL must be nonnegative seconds" >&2; exit 64;; esac
    [ "$interval" -gt 0 ] && [ -f "$STAMP" ] && [ -f "$SUCCESS_TIME" ] || return 1
    [ -n "${CHECK_HEALTH_COMMAND:-}" ] || return 1
    "$CHECK_HEALTH_COMMAND" --healthy || return 1
    last=$(cat "$SUCCESS_TIME")
    case "$last" in ''|*[!0-9]*) return 1;; esac
    elapsed=$(( $(date +%s) - last ))
    [ "$elapsed" -ge 0 ] && [ "$elapsed" -lt "$interval" ] || return 1
    log "$target" "result=deferred remaining=$((interval - elapsed))"
    echo "deploy-guard: batching changes for $((interval - elapsed)) more seconds (FORCE=1 to deploy now)."
}

cmd_run() {
    [ "$#" -ge 3 ] || { echo "usage: deploy-guard run <target> -- <command...>" >&2; exit 64; }
    target=$1
    shift
    [ "$1" = -- ] && shift

    check_recovery_hold
    if [ -n "${DEPLOY_GUARD_HELD:-}${DEPLOY_GUARD_OWNER_SHA256:-}${DEPLOY_GUARD_LOCK:-}" ]; then
        nested_owner || busy "invalid inherited guard ownership"
        trap 'guard_exit' EXIT
        trap 'exit 130' INT TERM
        trap 'exit 129' HUP
    else
        acquire "$target"
        owned_info=$info
        trap 'guard_exit' EXIT
        trap 'exit 130' INT TERM
        trap 'exit 129' HUP
        DEPLOY_GUARD_HELD=$$
        DEPLOY_GUARD_OWNER_SHA256=$(printf '%s\n' "$owned_info" | hash_stdin)
        DEPLOY_GUARD_LOCK=$LOCK
        export DEPLOY_GUARD_HELD DEPLOY_GUARD_OWNER_SHA256 DEPLOY_GUARD_LOCK
    fi

    # The previous owner could have published a hold after our first check but before acquisition.
    check_recovery_hold

    if unchanged; then
        log "$target" "result=skipped (nothing changed since the last deploy; FORCE=1 to override)"
        echo "deploy-guard: nothing changed since the last $target; skipping (FORCE=1 to override)."
        exit 0
    fi

    if cooldown; then exit 0; fi

    # The tree that goes into the build is the one fingerprinted now. Stamp it afterwards only if the
    # shared checkout did not change in the meantime; otherwise the image holds older bytes than the stamp.
    # Fingerprint before logging `started` so a fail-closed fingerprint never leaves an open attempt.
    if ! before=$(fingerprint); then
        log "$target" "result=failed (cannot fingerprint the checkout; nothing was changed)"
        exit 1
    fi
    log "$target" "result=started"
    attempt_open=1
    DEPLOY_EXPECTED_FINGERPRINT="$before"
    DEPLOY_NOOP_MARKER="$STAMP.noop.$$"
    [ ! -e "$DEPLOY_NOOP_MARKER" ] || rm -f "$DEPLOY_NOOP_MARKER"
    export DEPLOY_EXPECTED_FINGERPRINT DEPLOY_NOOP_MARKER
    check_recovery_hold
    if "$@"; then rc=0; else rc=$?; fi
    if [ "$rc" -eq 0 ] && [ "${STAMP_ON_SUCCESS:-0}" = 1 ]; then
        # One snapshot supplies both the comparison and the stamp, so a checkout change between
        # them cannot stamp per-service data that was never built or verified.
        stamp_tmp="$STAMP.tmp.$$"
        if "$DIR/bin/deploy-plan" --stamp-data "$target" >"$stamp_tmp" \
            && [ "$(head -n 1 "$stamp_tmp")" = "$before" ]; then
            mv -f "$stamp_tmp" "$STAMP"
            if [ -f "$DEPLOY_NOOP_MARKER" ]; then
                noop=1
            elif [ "${RECORD_DEPLOY_TIME:-0}" = 1 ]; then
                date +%s >"$SUCCESS_TIME"
            fi
        else
            # Keep the previous per-service record so the next run redeploys only what changed instead
            # of treating the stack as a first installation, but invalidate its fingerprint so it can
            # never satisfy an unchanged check for images this run may already have rolled out.
            if [ -f "$STAMP" ]; then
                { echo stale; tail -n +2 "$STAMP"; } >"$stamp_tmp" && mv -f "$stamp_tmp" "$STAMP"
            fi
            rm -f "$stamp_tmp"
            log "$target" "result=tree-changed-during-run (not stamped; the next build will run)"
            echo "deploy-guard: the checkout changed while $target ran, so what was built is already out of date; not deploying it. Run again." >&2
            rc=76
        fi
    fi
    [ ! -e "$DEPLOY_NOOP_MARKER" ] || rm -f "$DEPLOY_NOOP_MARKER"
    attempt_open=0
    if [ "${noop:-0}" = 1 ]; then
        log "$target" "result=finished rc=$rc (no service affected; stamped without a rollout)"
    else
        log "$target" "result=finished rc=$rc"
    fi
    exit "$rc"
}

# Before rolling out an image, check the checkout still matches the tree that image was built from.
cmd_verify() {
    [ -f "$STAMP" ] || exit 0
    if [ "$(head -n 1 "$STAMP")" != "$(fingerprint)" ]; then
        echo "deploy-guard: the checkout changed since the last build, so the image is out of date; not deploying it. Run again." >&2
        exit 76
    fi
}

cmd_verify_expected() {
    [ -n "${DEPLOY_EXPECTED_FINGERPRINT:-}" ] || { echo "deploy-guard: missing guarded deployment fingerprint" >&2; exit 64; }
    if [ "$(fingerprint)" != "$DEPLOY_EXPECTED_FINGERPRINT" ]; then
        echo "deploy-guard: source or effective Compose configuration changed during deployment; aborting." >&2
        exit 76
    fi
}

cmd_verify_owner() {
    nested_owner || busy "invalid inherited guard ownership"
    check_recovery_hold
}

case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    verify) cmd_verify ;;
    verify-expected) cmd_verify_expected ;;
    verify-owner) cmd_verify_owner ;;
    *) echo "usage: deploy-guard run <target> -- <command...>" >&2; exit 64 ;;
esac
