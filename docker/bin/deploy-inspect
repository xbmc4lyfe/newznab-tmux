#!/usr/bin/env python3
"""Reads `docker compose config --format json` on stdin for docker/bin/deploy.

  deploy-inspect name               the Compose project name
  deploy-inspect services           every service, in any profile
  deploy-inspect image-users IMAGE  services that run IMAGE
  deploy-inspect image-of SERVICE   the image SERVICE runs
  deploy-inspect refuse IMAGE       one line per setting the deploy cannot run safely (empty: none)
  deploy-inspect app-deps IMAGE SVC...  "service dependency" for each listed service that needs
                                    (directly or through others) a service running IMAGE
  deploy-inspect data BASE IMAGE    stateful services: not running IMAGE, and either listed in BASE
                                    (space-separated) or absent from the base roster read as names on
                                    fd 3, unless labelled nntmux.deploy.stateless: "true"
  deploy-inspect configs            one "service hash link" line per service that bind-mounts config
                                    (link: `link` if a source is reached through a symlink, else `-`)
  deploy-inspect storage            the same, for where existing writable bind mounts really land,
                                    then `link` if one is reached through a symlink, else `-`
  deploy-inspect interpolated FILE  keys of a dotenv FILE whose value Compose would interpolate

A service's config hash covers the content of every bind-mounted file, and of every file under a
read-only bind-mounted directory, wherever it lives (a persistent runtime directory outside the
checkout too) and following symlinks. Writable directories are data (database files, storage)
and are skipped, and so are host system paths (/, /proc, /sys, /dev, /run, Docker's own state),
such as node-exporter's mounts. It also covers the Compose configs and secrets the service uses:
a file source's content, an environment source's value (which must be set), inline content, or
an external resource's definition. Compose recreates a service only when its definition changes,
so deploy uses these hashes to recreate a service whose mounted config changed.
"""
import hashlib
import json
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from compose_dotenv import parse  # noqa: E402


def tree_digest(path: str, digest) -> None:
    if os.path.isfile(path):
        digest.update(path.encode() + b"\0")
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1 << 16), b""):
                digest.update(chunk)
        return
    for root, dirs, files in os.walk(path, followlinks=True):
        dirs.sort()
        for name in sorted(files):
            tree_digest(os.path.join(root, name), digest)


SYSTEM = ("/proc", "/sys", "/dev", "/run", "/var/run", "/var/lib/docker", "/private/var/run")


def inside(path: str, roots: list[str]) -> bool:
    real = os.path.realpath(path)
    return any(real == root or real.startswith(root + os.sep) for root in roots)


def system_path(path: str) -> bool:
    real = os.path.realpath(path)
    return real == "/" or inside(real, list(SYSTEM))


def config_sources(service: dict) -> tuple[list[str], list[str]]:
    """Mounted config (hashed by content) and writable storage (recorded by resolved identity)."""
    sources, storage = [], []
    for volume in service.get("volumes") or []:
        if volume.get("type") != "bind":
            continue
        source = volume.get("source", "")
        if os.path.isfile(source):
            sources.append(source)
        elif os.path.isdir(source) and not system_path(source):
            (sources if volume.get("read_only") else storage).append(source)
    return sorted(sources), sorted(storage)


def resource_digest(model: dict, service: dict, digest) -> bool:
    """Hash the Compose configs and secrets a service uses; False if it uses none."""
    used = False
    for kind in ("configs", "secrets"):
        defined = model.get(kind) or {}
        for ref in service.get(kind) or []:
            name = ref.get("source") if isinstance(ref, dict) else ref
            spec = defined.get(name) or {}
            used = True
            digest.update(f"{kind} {name}".encode() + b"\0")
            if spec.get("file"):
                tree_digest(spec["file"], digest)
            elif spec.get("environment"):
                var = spec["environment"]
                if var not in os.environ:
                    sys.exit(f"The {kind[:-1]} {name} reads ${var}, which isn't set here, so a change "
                             f"to it can't be detected. Set it in docker/.env or the environment.")
                digest.update(os.environ[var].encode() + b"\0")
            elif "content" in spec:
                digest.update(str(spec["content"]).encode() + b"\0")
            else:
                # External: managed outside this project; its name is all there is to record.
                digest.update(json.dumps(spec, sort_keys=True).encode() + b"\0")
    return used


def refusals(model: dict, image: str) -> list[str]:
    """Settings that would let Compose act outside the deploy's checks, as the old planner refused."""
    out = []
    services = model.get("services") or {}
    for name, svc in sorted(services.items()):
        app = svc.get("image") == image
        if svc.get("build"):
            out.append(f"{name}: has a build section; the deploy builds {image} itself")
        for key in ("network_mode", "ipc", "pid"):
            value = str(svc.get(key) or "")
            if value.startswith(("service:", "container:")):
                out.append(f"{name}: {key} {value} shares another container's namespace")
        if svc.get("volumes_from"):
            out.append(f"{name}: volumes_from ties it to another container's lifecycle")
        deps = svc.get("depends_on") or {}
        if isinstance(deps, dict):
            for dep, cond in deps.items():
                if isinstance(cond, dict) and cond.get("restart"):
                    out.append(f"{name}: depends_on.{dep}.restart restarts it outside the deploy")
        if app and name != "migrate":
            check = svc.get("healthcheck") or {}
            test = check.get("test") or []
            if not check or check.get("disable") or test in (["NONE"], "NONE") or test[:1] == ["NONE"]:
                out.append(f"{name}: needs a health check; the deploy only trusts a healthy app service")
        replicas = (svc.get("deploy") or {}).get("replicas", svc.get("scale", 1))
        labels = svc.get("labels") or {}
        stateless = isinstance(labels, dict) and str(labels.get("nntmux.deploy.stateless", "")).lower() == "true"
        # An app service or a database with several replicas could be migrated, fenced or written
        # on different backends; only a service labelled stateless may scale.
        if replicas not in (None, 1) and (app or not stateless):
            out.append(f"{name}: runs {replicas} replicas; only a service labelled "
                       f"nntmux.deploy.stateless: \"true\" may run more than one")
    # The pending check, migrations and the barrier all use migrate's database, so every app role
    # must connect to that same one.
    keys = ("DB_URL", "DB_CONNECTION", "DB_HOST", "DB_PORT", "DB_SOCKET", "DB_DATABASE")

    def connection(svc: dict) -> dict:
        env = svc.get("environment") or {}
        if isinstance(env, list):
            env = dict(item.split("=", 1) if "=" in item else (item, None) for item in env)
        return {key: env.get(key) for key in keys}

    reference = connection(services.get("migrate") or {})
    for name, svc in sorted(services.items()):
        if svc.get("image") != image or name == "migrate":
            continue
        differs = [key for key in keys if connection(svc)[key] != reference[key]]
        if differs:
            out.append(f"{name}: {', '.join(differs)} differ from migrate's, so it may use an unmigrated, unfenced database")
    return out


def through_link(path: str) -> bool:
    """Whether a mount source, or anything under it, is reached through a symlink."""
    if os.path.realpath(path) != os.path.abspath(path):
        return True
    for root, dirs, files in os.walk(path):
        if any(os.path.islink(os.path.join(root, entry)) for entry in dirs + files):
            return True
    return False


def storage_identity(path: str, digest) -> None:
    # Not the contents (a live database), but where the mount really lands: retargeting a symlink
    # or swapping the directory for restored storage changes this, so it enters the data preflight.
    real = os.path.realpath(path)
    info = os.stat(real)
    digest.update(f"storage {path} -> {real} {info.st_dev}:{info.st_ino}".encode() + b"\0")


def main() -> None:
    if sys.argv[1:2] == ["interpolated"]:
        # Compose interpolates `$` in env_file values too, so an unquoted or double-quoted secret
        # with a `$` in it reaches the container cut short. Single-quoted values are literal.
        # A reference to another key of the same file (`${PUSHER_APP_KEY}`) is deliberate and
        # resolves; anything else is flagged.
        parsed = parse(Path(sys.argv[2]))
        flagged = []
        for key, (value, flag) in parsed.items():
            names = re.findall(r"\$\{?([A-Za-z_][A-Za-z0-9_]*)", value)
            if flag == "multiline" or (flag and not (names and set(names) <= parsed.keys())):
                flagged.append(key)
        print("\n".join(sorted(flagged)))
        return
    model = json.load(sys.stdin)
    services = model.get("services") or {}
    command = sys.argv[1:2]
    if command == ["name"]:
        print(model.get("name", ""))
    elif command == ["services"]:
        print("\n".join(sorted(services)))
    elif command == ["data"]:
        base, image = set(sys.argv[2].split()), sys.argv[3]
        with os.fdopen(3) as handle:
            roster = set(handle.read().split())
        data = []
        for name, svc in services.items():
            labels = svc.get("labels") or {}
            if isinstance(labels, list):
                labels = dict(item.split("=", 1) if "=" in item else (item, "") for item in labels)
            if svc.get("image") == image or str(labels.get("nntmux.deploy.stateless", "")).lower() == "true":
                continue
            # A service an override adds (another database, say) holds data until it says otherwise.
            if name in base or name not in roster:
                data.append(name)
        print("\n".join(sorted(data)))
    elif command == ["app-deps"]:
        image = sys.argv[2]

        def needs(name: str) -> list[str]:
            deps = (services.get(name) or {}).get("depends_on") or {}
            return list(deps) if isinstance(deps, (dict, list)) else []

        for name in sys.argv[3:]:
            seen, queue = set(), needs(name)
            while queue:
                dep = queue.pop()
                if dep in seen:
                    continue
                seen.add(dep)
                if (services.get(dep) or {}).get("image") == image:
                    print(f"{name} {dep}")
                    break
                queue.extend(needs(dep))
    elif command == ["image-of"]:
        print((services.get(sys.argv[2]) or {}).get("image", ""))
    elif command == ["image-users"]:
        image = sys.argv[2]
        print("\n".join(sorted(name for name, svc in services.items() if svc.get("image") == image)))
    elif command == ["refuse"]:
        print("\n".join(refusals(model, sys.argv[2])))
    elif command == ["configs"]:
        for name in sorted(services):
            sources, _ = config_sources(services[name])
            digest = hashlib.sha256()
            for source in sources:
                tree_digest(source, digest)
            # Compose configs and secrets are mounted config too, from a file or the environment.
            if not resource_digest(model, services[name], digest) and not sources:
                continue
            linked = any(through_link(source) for source in sources)
            print(f"{name} {digest.hexdigest()} {'link' if linked else '-'}")
    elif command == ["storage"]:
        # Only storage that exists: Compose creates a missing bind source when it starts the service.
        for name in sorted(services):
            _, storage = config_sources(services[name])
            if not storage:
                continue
            digest = hashlib.sha256()
            for path in storage:
                storage_identity(path, digest)
            # Docker records the unresolved path, so a container can't say which target it mounted.
            linked = any(os.path.realpath(path) != os.path.abspath(path) for path in storage)
            print(f"{name} {digest.hexdigest()} {'link' if linked else '-'}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
