#!/bin/sh
# Run only through deploy-guard. Build dirty targets first, then drain/update only affected services.
set -eu
DIR=$(cd "$(dirname "$0")/.." && pwd)
COMPOSE_FILE="${COMPOSE_FILE:-$DIR/docker-compose.yml}"
export COMPOSE_FILE
compose() { "$DIR/bin/compose" "$@"; }
verify() {
    DEPLOY_CONFIG_COMMAND= DEPLOY_STAMP="$DIR/.build.stamp" "$DIR/bin/deploy-guard" verify
    "$DIR/bin/deploy-guard" verify-expected
}

scheduler_timeout="${DEPLOY_SCHEDULER_DRAIN_TIMEOUT:-1800}"
case "$scheduler_timeout" in
    ''|*[!0-9]*) echo "DEPLOY_SCHEDULER_DRAIN_TIMEOUT must be a nonnegative integer." >&2; exit 1 ;;
esac

"${JUST:-just}" --justfile "$DIR/Justfile" --working-directory "$DIR" build
verify

# Capture first: a failing plan inside eval "$(...)" would be ignored, and a stale MODE in the
# caller's environment must never stand in for the plan's output.
unset MODE MIGRATE DIRTY_APP DIRTY_DATA DIRTY_INFRA RECONCILE_DATA RECONCILE_INFRA START_DATA BUILD_TARGETS GLOBAL_FALLBACK
actions=$("$DIR/bin/deploy-plan" --deploy-actions)
eval "$actions"

# Remote worker hosts share the database but not this Compose project. The new image's barrier,
# a one-off container, stops their verification workers, waits for them and keeps them out while
# writers are stopped, data services change or migrations run. It is stopped only after a healthy
# rollout: a failed migration leaves remote workers held until the repaired deployment (which
# reuses a running barrier, whatever it then has to do) finishes, or an operator stops it.
# Named after Compose's effective project, so installations never share or adopt each other's barrier.
project=$(compose config --format json | python3 -c 'import json, sys; print(json.load(sys.stdin)["name"])')
case "$project" in
    ''|*[!a-z0-9_-]*) echo "Cannot resolve the Compose project for the verification barrier." >&2; exit 1 ;;
esac
barrier_name="$project-verification-barrier"
barrier_held=0
barrier_keep=0
barrier_running() {
    [ "$(docker inspect --format '{{.State.Running}} {{index .Config.Labels "com.docker.compose.project"}}' "$barrier_name" 2>/dev/null)" = "true $project" ]
}
hold_barrier() {
    # Owed from before the first pause until a release succeeds: any failure from here on, even
    # one that leaves no barrier container, makes the next run take a barrier and release it.
    owe_barrier
    # A barrier still running from a failed attempt is retained until this rollout is healthy.
    if barrier_running && ! docker logs "$barrier_name" 2>&1 | grep -q '^barrier lost'; then
        barrier_keep=1
    else
        docker rm -f "$barrier_name" >/dev/null 2>&1 || true
        compose run -d --no-deps --name "$barrier_name" web php artisan releases:verification-barrier --timeout="${DEPLOY_REMOTE_DRAIN_TIMEOUT:-900}" --no-interaction >/dev/null
    fi
    barrier_held=1
    until docker logs "$barrier_name" 2>&1 | grep -q '^barrier held'; do
        if ! barrier_running; then
            docker logs "$barrier_name" >&2 || true
            docker rm -f "$barrier_name" >/dev/null 2>&1 || true
            barrier_held=0
            echo "Remote verification workers did not drain; not stopping writers or migrating." >&2
            exit 1
        fi
        sleep 1
    done
}
assert_barrier() {
    [ "$barrier_held" = 1 ] || return 0
    if ! barrier_running || docker logs "$barrier_name" 2>&1 | grep -q '^barrier lost'; then
        echo "The verification barrier was lost; remote verification workers may be writing." >&2
        exit 1
    fi
}
release_barrier() {
    if [ "$barrier_held" = 1 ]; then
        docker stop --timeout 30 "$barrier_name" >/dev/null || true
        released=0
        docker logs "$barrier_name" 2>&1 | grep -q '^barrier released' && released=1
        docker rm -f "$barrier_name" >/dev/null 2>&1 || true
        barrier_held=0
        # Its durable pause would otherwise keep every host's workers out after a healthy rollout.
        if [ "$released" != 1 ] && ! compose run --rm --no-deps -T web php artisan releases:verification-barrier --release --no-interaction; then
            echo "The verification deployment pause could not be cleared; every host's workers stay paused." >&2
            return 1
        fi
    fi
}

# The barrier's durable pause can outlive its container (a lost session leaves it behind) and only
# a barrier's release clears it. A failed run that held a barrier marks it owed: the next run, even
# a no-op or selective one, takes a barrier and releases it, without repeating a completed migration.
barrier_owed="${DEPLOY_STAMP:-$DIR/.deploy.stamp}.barrier-owed"
owe_barrier() { : >"$barrier_owed" || echo "Could not record the owed barrier release; clear the verification pause by hand." >&2; }
settle_barrier() {
    if ! release_barrier; then
        owe_barrier
        return 1
    fi
    rm -f "$barrier_owed"
}

if [ "$MODE" = "noop" ]; then
    if barrier_running || [ -e "$barrier_owed" ]; then
        # A barrier or pause left by an earlier failed attempt must not hold remote workers out forever.
        hold_barrier
        settle_barrier
    fi
    # Nothing rolled out: let the guard stamp the new fingerprint without recording a deployment.
    if [ -n "${DEPLOY_NOOP_MARKER:-}" ]; then : >"$DEPLOY_NOOP_MARKER"; fi
    exit 0
fi

# From here on the stack changes. Invalidate the stamp's fingerprint first (keeping per-service
# records), forget each service's record before it is stopped or recreated, and record it again
# from the plan snapshot once healthy: a run failing at any point never leaves a stamp claiming
# something that is not running, and a retry repeats only what did not complete.
plan() { "$DIR/bin/deploy-plan" "$@"; }
plan --invalidate
# Data and infra services are applied one at a time (mark, up, record): a failing service never
# makes the next run repeat the ones that already came up. $1 is --pending (forced recreate) or
# --forget (non-forced up).
apply_each() {
    mark=$1
    shift
    for svc in "$@"; do
        plan "$mark" "$svc"
        if [ "$mark" = --pending ]; then
            compose up -d --no-deps --force-recreate --wait --wait-timeout "${DEPLOY_HEALTH_TIMEOUT:-240}" "$svc"
        else
            compose up -d --no-deps --wait --wait-timeout "${DEPLOY_HEALTH_TIMEOUT:-240}" "$svc"
        fi
        plan --record "$svc"
    done
}
# The rendered-Compose `effective` record covers only what no service record explains; a change to
# it always migrates, so it is recorded together with the completed migration.

# Stateless infrastructure first, while every writer still runs: a failing infra service aborts
# here, before any drain, instead of after a full app rollout that would then repeat every poll.
if [ -n "$DIRTY_INFRA" ]; then
    # shellcheck disable=SC2086
    apply_each --pending $DIRTY_INFRA
    verify
fi

if [ -n "$START_DATA" ]; then
    # Data services that have no container yet (e.g. newly rendered) are started without
    # quiescing writers: nothing uses them before this run.
    # shellcheck disable=SC2086
    apply_each --forget $START_DATA
    verify
fi

if [ -n "$RECONCILE_INFRA" ]; then
    # Compose recreates only services whose rendered configuration drifted.
    # shellcheck disable=SC2086
    apply_each --forget $RECONCILE_INFRA
    verify
fi

in_list() {
    needle=$1
    shift
    for item in "$@"; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

if [ "$MIGRATE" = 1 ] || [ -n "$DIRTY_DATA" ] || [ -n "$RECONCILE_DATA" ]; then
    need_scheduler_drain=1
    need_indexer_drain=1
    need_horizon_stop=1
    stop_services="web scheduler indexer"
    up_app_services="web horizon scheduler indexer"
    need_barrier=1
else
    need_barrier=0
    need_scheduler_drain=0
    need_indexer_drain=0
    need_horizon_stop=0
    stop_list=""
    for svc in web horizon scheduler indexer; do
        # shellcheck disable=SC2086
        if in_list "$svc" $DIRTY_APP; then
            case "$svc" in
                scheduler) need_scheduler_drain=1; stop_list="${stop_list:+$stop_list }scheduler" ;;
                indexer) need_indexer_drain=1; stop_list="${stop_list:+$stop_list }indexer" ;;
                horizon) need_horizon_stop=1 ;;
                web) ;;
            esac
        fi
    done
    stop_services="$stop_list"
    up_app_services="$DIRTY_APP"
fi

drained=0
legacy=0
scheduler_drained=0
scheduler_legacy=0
horizon_stopped=0
operation_token=$(python3 -c 'import secrets; print(secrets.token_hex(16))')
legacy_drain() { compose exec -T indexer php -- /app "$1" "${DEPLOY_LEGACY_DRAIN_TIMEOUT:-1800}" "$operation_token" < "$DIR/bin/legacy-drain.php"; }
legacy_scheduler() { compose exec -T scheduler python3 - "$1" "$scheduler_timeout" "$operation_token" < "$DIR/bin/legacy-scheduler-drain.py"; }
scheduler_command() { compose exec -T scheduler python3 /app/docker/app/bin/scheduler.py "$@"; }
resume() {
    rc=$?
    if [ "$barrier_held" = 1 ] && [ "$rc" != 0 ]; then
        owe_barrier
    fi
    if [ "$barrier_held" = 1 ] && [ "$barrier_keep" = 1 ]; then
        # Never release after the migration began: a barrier that lost its session left its
        # durable pause, which must keep remote workers off a half-migrated schema.
        echo "Remote verification workers stay held by container $barrier_name (or its durable pause) until a repaired deployment completes or it is stopped." >&2
    else
        release_barrier || true
    fi
    if [ "$horizon_stopped" = 1 ]; then
        compose start horizon || echo "Horizon restart failed; queued jobs wait until it runs." >&2
    fi
    if [ "$scheduler_drained" = 1 ]; then
        if [ "$scheduler_legacy" = 1 ]; then
            legacy_scheduler resume || echo "Legacy scheduler restoration failed; inspect its admission state before retrying." >&2
        else
            scheduler_command restore --token="$operation_token" || echo "Scheduler restoration failed; admission may remain paused." >&2
        fi
    fi
    if [ "$drained" = 1 ]; then
        if [ "$legacy" = 1 ]; then
            legacy_drain resume || echo "Legacy indexer restoration failed; scheduling may remain paused." >&2
        else
            compose exec -T indexer php artisan tmux:drain --resume --session=nntmux --token="$operation_token" --no-interaction || echo "Indexer restoration failed; scheduling may remain paused." >&2
        fi
    fi
}
trap 'resume' EXIT
trap 'exit 130' INT TERM
# dash (Linux /bin/sh) skips EXIT traps on an untrapped SIGHUP, e.g. a dropped SSH session.
trap 'exit 129' HUP

# Probe the drain capability of every writer this run touches before stopping anything. A failed
# probe is distinct from an old image; it must never silently select the legacy path.
scheduler=""
indexer=""
if [ "$need_scheduler_drain" = 1 ]; then
    scheduler=$(compose ps -q scheduler)
    if [ -n "$scheduler" ]; then
        capability=$(compose exec -T scheduler python3 -c 'from pathlib import Path; print("native" if Path("/app/docker/app/bin/scheduler.py").is_file() else "legacy")')
        case "$capability" in
            native) ;;
            legacy)
                if [ "${DEPLOY_LEGACY_DRAIN:-0}" != 1 ]; then
                    echo "Old scheduler requires the authorized DEPLOY_LEGACY_DRAIN=1 transition." >&2
                    exit 1
                fi
                scheduler_legacy=1 ;;
            *) echo "Cannot verify scheduler drain capability." >&2; exit 1 ;;
        esac
    fi
fi
if [ "$need_indexer_drain" = 1 ]; then
    indexer=$(compose ps -q indexer)
    if [ -n "$indexer" ]; then
        commands=$(compose exec -T indexer php artisan list --raw --no-interaction)
        if ! printf '%s\n' "$commands" | grep -q '^tmux:drain[[:space:]]'; then
            if [ "${DEPLOY_LEGACY_DRAIN:-0}" != 1 ]; then
                echo "Old image lacks tmux:drain. Authorized first upgrades require DEPLOY_LEGACY_DRAIN=1; legacy IRC disconnects at final stop." >&2
                exit 1
            fi
            legacy=1
        fi
    fi
fi

if [ "$need_horizon_stop" = 1 ]; then
    # Let active Horizon jobs finish first while the scheduler and indexer keep producing work,
    # which queues in Redis for the new Horizon; waiting for Horizon after their drains idled every
    # writer for its whole grace. The explicit timeout also protects containers created before the
    # longer Compose grace. A checked assignment: a failed lookup aborts, never reads as absent.
    horizon=$(compose ps -q horizon)
    if [ -n "$horizon" ]; then
        horizon_stopped=1
        compose stop --timeout 1920 horizon
        verify
    fi
fi

# Pause scheduled admission before waiting for the indexer.
if [ -n "$scheduler" ]; then
    scheduler_drained=1
    if [ "$scheduler_legacy" = 1 ]; then
        legacy_scheduler drain
    else
        scheduler_command drain --timeout="$scheduler_timeout" --token="$operation_token"
    fi
    verify
fi

if [ -n "$indexer" ]; then
    drained=1
    if [ "$legacy" = 1 ]; then
        legacy_drain drain
    else
        compose exec -T indexer php artisan tmux:drain --timeout="${DEPLOY_DRAIN_TIMEOUT:-900}" --session=nntmux --token="$operation_token" --no-interaction
    fi
    verify
fi

# Drains succeeded; until here a failure restarted Horizon's old container and resumed the old
# writers, so their records stayed true. From the first irreversible stop on, the services this
# run replaces no longer match their records, and the migration it owes is not done.
# shellcheck disable=SC2086
[ -z "$up_app_services" ] || plan --forget $up_app_services
[ "$MIGRATE" != 1 ] || plan --forget migration

if [ "$scheduler_legacy" = 1 ]; then
    legacy_scheduler check
    verify
    compose stop --timeout 1 scheduler
    scheduler_drained=0
    verify
elif [ "$scheduler_drained" = 1 ]; then
    scheduler_command check
    verify
fi

# Remote workers are held out whenever the database's writers stop for a schema or data-service
# change; a barrier left running by an earlier failed attempt is adopted and released on success.
if [ "$need_barrier" = 1 ] || barrier_running || [ -e "$barrier_owed" ]; then
    hold_barrier
    verify
fi

if [ -n "$stop_services" ]; then
    # shellcheck disable=SC2086
    compose stop $stop_services
    drained=0
    scheduler_drained=0
    verify
fi
assert_barrier
# Past this point Horizon is replaced, never restarted on its old container.
horizon_stopped=0

if [ -n "$DIRTY_DATA" ]; then
    # shellcheck disable=SC2086
    apply_each --pending $DIRTY_DATA
    verify
fi

if [ -n "$RECONCILE_DATA" ]; then
    # Without a stamp, only Compose drift is reconciled; unchanged data services keep running.
    # shellcheck disable=SC2086
    apply_each --forget $RECONCILE_DATA
    verify
fi

if [ "$barrier_held" = 1 ] && { [ -n "$DIRTY_DATA" ] || [ -n "$RECONCILE_DATA" ]; }; then
    # A recreated database ends the barrier's lock session. Its durable pause keeps workers out
    # meanwhile; take a fresh barrier on the healthy service before migrating or starting writers.
    docker rm -f "$barrier_name" >/dev/null 2>&1 || true
    keep=$barrier_keep
    barrier_held=0
    hold_barrier
    barrier_keep=$keep
    verify
fi

if [ "$MIGRATE" = 1 ]; then
    assert_barrier
    [ "$barrier_held" != 1 ] || barrier_keep=1
    compose run --rm --no-deps web php artisan migrate --force --no-interaction
    assert_barrier
    plan --record migration effective
    verify
fi

if [ -n "$up_app_services" ]; then
    # shellcheck disable=SC2086
    if compose up -d --no-deps --force-recreate --wait --wait-timeout "${DEPLOY_HEALTH_TIMEOUT:-240}" $up_app_services; then
        :
    else
        up_rc=$?
        # Keep the services that did come up healthy on this run's image; the retry repeats the rest.
        # shellcheck disable=SC2086
        plan --record-healthy $up_app_services || true
        exit "$up_rc"
    fi
    # shellcheck disable=SC2086
    plan --record $up_app_services
fi
assert_barrier
barrier_keep=0
settle_barrier || exit 1
