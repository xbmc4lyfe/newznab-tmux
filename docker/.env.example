# Compose-level settings for docker/docker-compose.yml (copied to docker/.env by bin/generate-env).
# Secrets below are generated; keep docker/.env out of git (it is ignored).

COMPOSE_PROJECT_NAME=nntmux

# Front proxy (Caddy). 127.0.0.1 = this Mac only; 0.0.0.0 = LAN.
PROXY_BIND=127.0.0.1
APP_PORT=8080
# Internal endpoints for remote verification workers (no authentication). Bind it only to an
# interface the worker hosts reach, never one forwarded from the internet; 127.0.0.1 disables it.
INTERNAL_BIND=127.0.0.1
INTERNAL_PORT=8090
# Public origin (scheme://host:port, no trailing slash) used for Laravel's APP_URL and Grafana's
# root URL. Blank = http://localhost:$APP_PORT. Set it to the LAN address when PROXY_BIND=0.0.0.0,
# then re-run `just -f docker/Justfile env` and `just -f docker/Justfile up` (config/app.env takes its APP_URL from here).
APP_URL=
MAILPIT_PORT=8025
PROMETHEUS_PORT=9090

TZ=UTC

# Worker Pulse master switch; web records independently. Keep false for normal processing.
# Opt in with PULSE_ENABLED=true here AND PULSE_PROCESSING_ENABLED=true in config/app.env.
# Recreate app containers through guarded deployment after changes; refresh cached Laravel
# configuration in the replacement containers before expecting the new settings to apply.
PULSE_ENABLED=false

# Image tags. BASE_IMAGE only names the locally built cached base stage (role targets build from the
# Dockerfile stage, not this tag). Leave role tags blank to use nntmux/<role>:local or a custom APP_IMAGE.
# Literal values only: docker/Justfile and docker/bin/compose read DC, COMPOSE_FILE, HELPER_IMAGE and the
# BASE/APP/WEB/HORIZON/SCHEDULER/INDEXER_IMAGE keys themselves and do not expand Compose `$`
# interpolation, so `APP_IMAGE=${REGISTRY}/nntmux:${TAG}` (unquoted or double-quoted) is refused with an
# error. Write the final value, or single-quote it ('...$...' is taken verbatim, as Compose does).
# A trailing `KEY=` argument (e.g. `just deploy WEB_IMAGE= COMPOSE_FILE=`) overrides a value set here
# with "unset": the image falls back to its default tag and COMPOSE_FILE to docker/docker-compose.yml.
BASE_IMAGE=nntmux/base:local
APP_IMAGE=nntmux/app:local
WEB_IMAGE=
HORIZON_IMAGE=
SCHEDULER_IMAGE=
INDEXER_IMAGE=
MARIADB_IMAGE=mariadb:11.4.8
REDIS_IMAGE=redis:7.4.2-alpine
MANTICORE_IMAGE=manticoresearch/manticore:28.4.4
CADDY_IMAGE=caddy:2.10.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27.10

# Database credentials (must match DB_* in config/app.env; generate-env writes both).
DB_DATABASE=nntmux
DB_USERNAME=nntmux
DB_PASSWORD=__GENERATED__
DB_ROOTPASSWORD=__GENERATED__

# Memory caps (OrbStack currently allows ~24.5 GB). MariaDB's buffer pool lives in
# config/mariadb/conf.d/99-nntmux.cnf; keep it ~2 GB below MARIADB_MEMORY.
MARIADB_MEMORY=13g
MANTICORE_MEMORY=3g
REDIS_MEMORY=1g
INDEXER_MEMORY=8g
# Failed tmux health checks (30s apart) before the indexer exits and Docker recreates it.
INDEXER_MAX_FAILURES=10
# Seconds allowed to drain active indexing during SIGTERM; keep below the 120s stop grace.
INDEXER_DRAIN_TIMEOUT=90
# Deployment preflight waits this long for scheduled background jobs, then aborts safely.
DEPLOY_SCHEDULER_DRAIN_TIMEOUT=1800
WEB_MEMORY=1g
HORIZON_MEMORY=1g
SCHEDULER_MEMORY=1g
