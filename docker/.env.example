# Compose-level settings for docker/docker-compose.yml (copied to docker/.env by bin/generate-env).
# Secrets below are generated; keep docker/.env out of git (it is ignored).

COMPOSE_PROJECT_NAME=nntmux
# Who `just deploy` records in the deploy log. Required for a deploy.
DEPLOY_BY=
# `just deploy` refuses to run unless the checkout is on this branch and matches the remote.
# 0 skips the remote check, for offline testing only.
DEPLOY_SYNC_REMOTE=1
DEPLOY_GIT_REMOTE=origin
DEPLOY_GIT_BRANCH=rust-native
# Seconds `just deploy` waits for every service to report healthy.
DEPLOY_HEALTH_TIMEOUT=600

# Front proxy (Caddy). 127.0.0.1 = this host only; 0.0.0.0 = LAN.
PROXY_BIND=127.0.0.1
APP_PORT=8080
# Internal endpoints for remote verification workers (no authentication). Bind it only to an
# interface the worker hosts reach, never one forwarded from the internet; 127.0.0.1 disables it.
INTERNAL_BIND=127.0.0.1
INTERNAL_PORT=8090
# Public origin (scheme://host:port, no trailing slash) for APP_URL. Blank = http://localhost:$APP_PORT.
APP_URL=
MAILPIT_PORT=8025
PROMETHEUS_PORT=9090
# Grafana listens on 127.0.0.1 only; sign in as nntmux-grafana-admin with the generated password.
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=__GENERATED__

TZ=UTC

# Image tags. Literal values only.
APP_IMAGE=nntmux/rust:local
MARIADB_IMAGE=mariadb:11.4.8
REDIS_IMAGE=redis:7.4.2-alpine
MANTICORE_IMAGE=manticoresearch/manticore:28.4.4
CADDY_IMAGE=caddy:2.10.2-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.27.10

# Database credentials (must match DB_* in config/app.env; generate-env writes both).
DB_DATABASE=nntmux
DB_USERNAME=nntmux
DB_PASSWORD=__GENERATED__
DB_ROOTPASSWORD=__GENERATED__

# Memory caps. MariaDB's buffer pool lives in config/mariadb/conf.d/99-nntmux.cnf; keep it
# ~2 GB below MARIADB_MEMORY.
MARIADB_MEMORY=13g
MANTICORE_MEMORY=3g
REDIS_MEMORY=1g
WEB_MEMORY=1g
# Each worker role (supervisor, releases, fixnames, predb, fingerprint, verify, search-sync, ...).
WORKER_MEMORY=2g
POSTPROCESS_MEMORY=4g
