{
	admin off
	auto_https off
}

# Front proxy for the NNTmux docker/ stack. APP_URL in docker/.env must match the address clients use.
:8080 {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Remote-worker endpoints are served only on the internal listener below.
	handle /internal/* {
		respond 404
	}

	handle {
		reverse_proxy web:8080
	}
}

# Internal listener for remote verification workers. Its port is published separately
# (INTERNAL_BIND), so the public site can stay reachable while this one stays on the LAN.
:8090 {
	handle /internal/* {
		reverse_proxy web:8080
	}

	handle {
		respond 404
	}
}
