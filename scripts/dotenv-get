#!/usr/bin/env python3
"""Print KEY from ./.env (or DEFAULT when absent/empty) using the Compose-compatible rules that
docker/bin/compose and docker/Justfile apply: optional `export`, spaces around `=`, quoted values
with an optional trailing comment, unquoted values ending at an inline ` #` comment, last wins.
Unquoted and double-quoted values are interpolated like Compose and phpdotenv (`$VAR`, `${VAR}`,
`${VAR:-default}`, `${VAR-default}`) from the environment, then earlier assignments in the file."""
import os
import re
import sys
from pathlib import Path

# --raw: an empty value is returned as empty; DEFAULT only replaces a missing key (make's ?=).
raw_mode = len(sys.argv) > 1 and sys.argv[1] == "--raw"
args = sys.argv[2:] if raw_mode else sys.argv[1:]
key, default = args[0], (args[1] if len(args) > 1 else "")

REFERENCE = re.compile(r"\$(?:\{([A-Za-z_][A-Za-z0-9_]*)(?:(:?-)([^}]*))?\}|([A-Za-z_][A-Za-z0-9_]*))")


def interpolate(text: str, seen: dict) -> str:
    def lookup(match: "re.Match[str]") -> str:
        name = match.group(1) or match.group(4)
        current = os.environ.get(name, seen.get(name))
        operator, fallback = match.group(2), match.group(3) or ""
        if operator == ":-" and not current:
            return fallback
        if operator == "-" and current is None:
            return fallback
        return current or ""
    return REFERENCE.sub(lookup, text)


values: dict = {}
try:
    lines = Path(".env").read_text(encoding="utf-8", errors="surrogateescape").splitlines()
except OSError:
    lines = []
for raw in lines:
    m = re.match(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$", raw)
    if not m:
        continue
    quoted = re.match(r"""^(["'])((?:(?!\1).)*)\1\s*(?:#.*)?$""", m.group(2))
    value = quoted.group(2) if quoted else re.sub(r"\s#.*$", "", m.group(2)).strip()
    if not (quoted and quoted.group(1) == "'"):
        value = interpolate(value, values)
    values[m.group(1)] = value
value = values.get(key)
if raw_mode:
    sys.stdout.write(default if value is None else value)
else:
    sys.stdout.write(value or default)
